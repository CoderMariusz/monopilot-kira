[1m/bin/zsh -lc 'rtk wc -l .claude/skills/MON-verify-and-review/SKILL.md .agents/skills/MON-domain-technical/SKILL.md .agents/skills/MON-t2-api/SKILL.md .agents/skills/MON-t4-test/SKILL.md /Users/mariuszkrawczyk/.codex/plugins/cache/claude-plugins-official/superpowers/6.1.1/skills/using-superpowers/SKILL.md /Users/mariuszkrawczyk/.codex/plugins/cache/claude-plugins-official/superpowers/6.1.1/skills/systematic-debugging/SKILL.md /Users/mariuszkrawczyk/.codex/plugins/cache/claude-plugins-official/superpowers/6.1.1/skills/test-driven-development/SKILL.md'[0m in /Users/mariuszkrawczyk/Projects/monopilot-kira
