   411	const LAUNCH_CRITERION_LABELS: Record<keyof ApprovalCriteriaResult, string> = {
   412	  C1: 'Recipe locked',
   413	  C2: 'Nutrition score',
   414	  C3: 'Target margin',
   415	  C4: 'Sensory panel',
   416	  C5: 'Allergen audit',
