    59	export async function listWipDefinitions(input?: ListWipDefinitionsInput): Promise<ActionResult<{ definitions: unknown[] }>> {
    60	  const parsed = listWipDefinitionsInputSchema.safeParse(input);
    61	  if (!parsed.success) return { ok: false, error: 'Invalid WIP definition filter', code: 'VALIDATION_ERROR' };
    62	
    63	  return withOrgContext<ActionResult<{ definitions: unknown[] }>>(async (ctx) => {
    64	    // Reads are org-scoped and open (canonical technical/items pattern);
    65	    // technical.wip.* gates WRITES only — viewers get the read-only library.
    66	    const filter = parsed.data ?? {};
    67	    const rows = await ctx.client.query(
    68	      `select d.id,
    69	              d.name,
    70	              d.base_uom as "baseUom",
    71	              d.version,
    72	              d.status,
    73	              d.reusable,
    74	              i.item_code as "itemCode",
    75	              coalesce(proc.process_count, 0)::int as "processCount",
    76	              coalesce(refs.project_count, 0)::int as "referencingProjects"
    77	         from public.wip_definitions d
    78	         left join public.items i on i.id = d.item_id and i.org_id = d.org_id
    79	         left join lateral (
    80	           select count(*)::int as process_count
    81	             from public.wip_definition_processes p
    82	            where p.org_id = d.org_id and p.wip_definition_id = d.id
    83	         ) proc on true
    84	         left join lateral (
    85	           select count(distinct f.project_id)::int as project_count
    86	             from public.formulation_ingredients fi
    87	             join public.formulation_versions fv on fv.id = fi.version_id
    88	             join public.formulations f on f.id = fv.formulation_id and f.org_id = d.org_id
    89	            where fi.wip_definition_id = d.id
    90	         ) refs on true
    91	        where d.org_id = app.current_org_id()
    92	          and ($1::text is null or d.status = $1::text)
    93	          and ($2::boolean is null or d.reusable = $2::boolean)
    94	          and ($3::text is null or d.name ilike '%' || $3::text || '%')
    95	        order by d.updated_at desc, d.name asc`,
    96	      [filter.status ?? null, filter.reusable ?? null, filter.q ?? null],
    97	    );
    98	    return { ok: true, definitions: rows.rows };
    99	  });
   100	}
   101	
   102	export async function getWipDefinition(
   103	  id: string,
   104	): Promise<
   105	  ActionResult<{
   106	    definition: unknown;
   107	    ingredients: unknown[];
   108	    processes: unknown[];
   109	    whereUsed: unknown[];
   110	    resolvedFromId?: string;
   111	  }>
   112	> {
   113	  if (!id || typeof id !== 'string') return { ok: false, error: 'Invalid WIP definition id', code: 'VALIDATION_ERROR' };
   114	
   115	  return withOrgContext<
   116	    ActionResult<{
   117	      definition: unknown;
   118	      ingredients: unknown[];
   119	      processes: unknown[];
   120	      whereUsed: unknown[];
   121	      resolvedFromId?: string;
   122	    }>
   123	  >(async (ctx) => {
   124	    // Read is org-scoped and open (technical/items pattern) — writes stay gated.
   125	    const resolved = await resolveWipReadTarget(ctx, id);
   126	    if (!resolved) return { ok: false, error: 'WIP definition not found', code: 'NOT_FOUND', status: 404 };
   127	
   128	    const definition = await ctx.client.query(
   129	      `select d.*, i.item_code
   130	         from public.wip_definitions d
   131	         left join public.items i on i.id = d.item_id and i.org_id = d.org_id
   132	        where d.id = $1::uuid and d.org_id = app.current_org_id()
   133	        limit 1`,
   134	      [resolved.id],
   135	    );
   136	    if (!definition.rows[0]) return { ok: false, error: 'WIP definition not found', code: 'NOT_FOUND', status: 404 };
   137	
   138	    const ingredients = await ctx.client.query(
   139	      `select wi.id, wi.item_id as "itemId", i.item_code as "itemCode", i.name, wi.qty_per_unit as "qtyPerUnit", wi.uom, wi.sequence
   140	         from public.wip_definition_ingredients wi
   141	         join public.items i on i.id = wi.item_id and i.org_id = wi.org_id
   142	        where wi.org_id = app.current_org_id() and wi.wip_definition_id = $1::uuid
   143	        order by wi.sequence asc, i.name asc`,
   144	      [resolved.id],
   145	    );
   146	    const processes = await loadDefinitionProcesses(ctx, resolved.id);
   147	    const whereUsed = await loadWhereUsed(ctx, resolved.id);
   148	    return {
   149	      ok: true,
   150	      definition: definition.rows[0],
   151	      ingredients: ingredients.rows,
   152	      processes,
   153	      whereUsed,
   154	      ...(resolved.redirectedFromId ? { resolvedFromId: resolved.redirectedFromId } : {}),
   155	    };
   156	  });
   157	}
   158	
   159	export async function saveWipDefinition(input: SaveWipDefinitionInput): Promise<ActionResult<{ id: string; version: number }>> {
   160	  const parsed = saveWipDefinitionInputSchema.safeParse(input);
   161	  if (!parsed.success) return { ok: false, error: 'Invalid WIP definition input', code: 'VALIDATION_ERROR' };
   162	  const data = preserveProcessYieldPct(parsed.data, input);
   163	
   164	  return withOrgContext<ActionResult<{ id: string; version: number }>>(async (ctx) => {
   165	    const requiredPermission = data.id ? EDIT_PERMISSION : CREATE_PERMISSION;
   166	    if (!(await hasPermission(ctx, requiredPermission))) {
   167	      return { ok: false, error: `${requiredPermission} is required`, code: 'FORBIDDEN', status: 403 };
   168	    }
   169	
   170	    const existing = data.id ? await loadExistingDefinition(ctx, data.id) : null;
   171	    if (data.id && !existing) return { ok: false, error: 'WIP definition not found', code: 'NOT_FOUND', status: 404 };
   172	
   173	    const writeTarget = existing ? await resolveWipWriteTarget(ctx, data.id!) : null;
   174	    if (existing && !writeTarget) {
   175	      return {
   176	        ok: false,
   177	        error: 'WIP definition was superseded concurrently',
   178	        code: 'SUPERCEDE_CONFLICT',
   179	        status: 409,
   180	      };
   181	    }
   182	
   183	    const beforeContent = writeTarget ? await loadDefinitionContent(ctx, writeTarget.id, writeTarget) : null;
   184	    const afterContent = canonicalInputContent(data);
   185	    const contentChanged = !beforeContent || JSON.stringify(beforeContent) !== JSON.stringify(afterContent);
   186	    const nextVersion = writeTarget ? writeTarget.version + (contentChanged ? 1 : 0) : 1;
   187	
   188	    const prospectiveItemId = writeTarget?.item_id ?? null;
   189	    if (prospectiveItemId) {
   190	      const cycleGuard = await assertWipDefinitionCompositionAcyclic(
   191	        ctx.client,
   192	        prospectiveItemId,
   193	        data.ingredients.map((ingredient) => ingredient.itemId),
   194	      );
   195	      if (!cycleGuard.ok) {
   196	        return {
   197	          ok: false,
   198	          error: 'WIP definition composition would introduce a cycle',
   199	          code: cycleGuard.code,
   200	          status: 409,
   201	        };
   202	      }
   203	    }
   204	
   205	    const itemId = prospectiveItemId ?? (await ensureDefinitionItem(ctx, data.name, data.baseUom));
   206	
   207	    if (!prospectiveItemId) {
   208	      const cycleGuard = await assertWipDefinitionCompositionAcyclic(
   209	        ctx.client,
   210	        itemId,
   211	        data.ingredients.map((ingredient) => ingredient.itemId),
   212	      );
   213	      if (!cycleGuard.ok) {
   214	        return {
   215	          ok: false,
   216	          error: 'WIP definition composition would introduce a cycle',
   217	          code: cycleGuard.code,
   218	          status: 409,
   219	        };
   220	      }
   221	    }
   222	    const cloneOnWrite = Boolean(writeTarget && writeTarget.status === 'active' && contentChanged);
   223	
   224	    const saved = cloneOnWrite
   225	      ? await ctx.client.query<{ id: string; version: number }>(
   226	          `insert into public.wip_definitions
   227	             (org_id, item_id, name, description, base_uom, yield_pct, version, status, reusable,
   228	              source_project_id, supersedes_wip_definition_id, created_by)
   229	           values
   230	             (app.current_org_id(), $1::uuid, $2, $3, $4, $5::numeric, $6::int,
   231	              'draft', $7::boolean, $8::uuid, $9::uuid, $10::uuid)
   232	           returning id, version`,
   233	          [
   234	            itemId,
   235	            data.name,
   236	            data.description ?? null,
   237	            data.baseUom,
   238	            data.yieldPct,
   239	            nextVersion,
   240	            data.reusable,
   241	            writeTarget!.source_project_id,
   242	            writeTarget!.id,
   243	            ctx.userId,
   244	          ],
   245	        )
   246	      : writeTarget
   247	      ? await ctx.client.query<{ id: string; version: number }>(
   248	          `update public.wip_definitions
   249	              set name = $2,
   250	                  description = $3,
   251	                  base_uom = $4,
   252	                  yield_pct = $5::numeric,
   253	                  reusable = $6::boolean,
   254	                  item_id = $7::uuid,
   255	                  version = $8::int,
   256	                  status = case when $6::boolean and status = 'draft' then 'active' else status end,
   257	                  updated_at = now()
   258	            where id = $1::uuid
   259	              and org_id = app.current_org_id()
   260	          returning id, version`,
   261	          [
   262	            writeTarget.id,
   263	            data.name,
   264	            data.description ?? null,
   265	            data.baseUom,
   266	            data.yieldPct,
   267	            data.reusable,
   268	            itemId,
   269	            nextVersion,
   270	          ],
   271	        )
   272	      : await ctx.client.query<{ id: string; version: number }>(
   273	          `insert into public.wip_definitions
   274	             (org_id, item_id, name, description, base_uom, yield_pct, version, status, reusable, created_by)
   275	           values
   276	             (app.current_org_id(), $1::uuid, $2, $3, $4, $5::numeric, 1,
   277	              case when $6::boolean then 'active' else 'draft' end, $6::boolean, $7::uuid)
   278	           returning id, version`,
   279	          [itemId, data.name, data.description ?? null, data.baseUom, data.yieldPct, data.reusable, ctx.userId],
   280	        );
   281	
   282	    const definitionId = saved.rows[0]?.id;
   283	    if (!definitionId) throw new Error('Could not save WIP definition');
   284	
   285	    await replaceDefinitionIngredients(ctx, definitionId, data.ingredients);
   286	    await replaceDefinitionProcesses(ctx, definitionId, data.processes);
   287	    await refreshWipItemAllergens(ctx, itemId, data.ingredients.map((ingredient) => ingredient.itemId));
   288	
   289	    if (cloneOnWrite && data.reusable) {
   290	      const archived = await ctx.client.query(
   291	        `update public.wip_definitions wip
   292	            set status = 'archived',
   293	                updated_at = now()
   294	          where wip.id = $1::uuid
   295	            and wip.org_id = app.current_org_id()
   296	            and wip.status = 'active'`,
   297	        [writeTarget!.id],
   298	      );
   299	      if (archived.rowCount !== 1) {
   300	        throw new Error('WIP_SUPERCEDE_CONFLICT');
   301	      }
   302	      await ctx.client.query(
   303	        `update public.wip_definitions wip
   304	            set status = 'active',
   305	                updated_at = now()
   306	          where wip.id = $1::uuid
   307	            and wip.org_id = app.current_org_id()`,
   308	        [definitionId],
   309	      );
   310	    }
   311	
   312	    if (writeTarget && contentChanged) {
   313	      await emitDefinitionUpdated(ctx, definitionId, nextVersion);
   314	      await fanOutDefinitionNotifications(ctx, definitionId, data.name, nextVersion);
   315	    }
   316	
   317	    return { ok: true, id: definitionId, version: nextVersion };
   318	  });
   319	}
   320	
   321	export async function publishWipDefinitionFromComponent(input: PublishWipDefinitionFromComponentInput): Promise<ActionResult<{ id: string }>> {
   322	  const parsed = publishWipDefinitionFromComponentInputSchema.safeParse(input);
   323	  if (!parsed.success) return { ok: false, error: 'Invalid publish input', code: 'VALIDATION_ERROR' };
   324	
   325	  return withOrgContext<ActionResult<{ id: string }>>(async (ctx) => {
   326	    if (!(await hasPermission(ctx, NPD_PRODUCTION_WRITE_PERMISSION))) {
   327	      return { ok: false, error: `${NPD_PRODUCTION_WRITE_PERMISSION} is required`, code: 'FORBIDDEN', status: 403 };
   328	    }
   329	
   330	    // D42: the WIP's base unit = the creating process's OUTPUT unit — taken from the
   331	    // LAST process in the component chain (throughput_uom, mig 429); fallback 'kg'.
   332	    const component = await ctx.client.query<{ project_id: string | null; output_uom: string }>(
   333	      `select p.id as project_id,
   334	              coalesce(last_proc.throughput_uom, 'kg') as output_uom
   335	         from public.prod_detail pd
   336	         left join public.npd_projects p on p.product_code = pd.product_code and p.org_id = pd.org_id
   337	         left join lateral (
   338	           select wp.throughput_uom
   339	             from public.npd_wip_processes wp
   340	            where wp.org_id = pd.org_id
   341	              and wp.prod_detail_id = pd.id
   342	              and wp.throughput_uom in ('kg', 'g', 'each', 'pack')
   343	            order by wp.display_order desc
   344	            limit 1
   345	         ) last_proc on true
   346	        where pd.id = $1::uuid
   347	          and pd.org_id = app.current_org_id()
   348	        limit 1`,
   349	      [parsed.data.prodDetailId],
   350	    );
   351	    const componentRow = component.rows[0];
   352	    if (!componentRow) return { ok: false, error: 'Production component not found', code: 'NOT_FOUND', status: 404 };
   353	
   354	    // Idempotency: a component publishes at most one definition — a re-submit
   355	    // returns the existing one instead of minting duplicates (review M2).
   356	    const alreadyPublished = await ctx.client.query<{ wip_definition_id: string }>(
   357	      `select wip_definition_id::text
   358	         from public.npd_wip_processes
   359	        where org_id = app.current_org_id()
   360	          and prod_detail_id = $1::uuid
   361	          and wip_definition_id is not null
   362	        limit 1`,
   363	      [parsed.data.prodDetailId],
   364	    );
   365	    const existingDefinitionId = alreadyPublished.rows[0]?.wip_definition_id;
   366	    if (existingDefinitionId) return { ok: true, id: existingDefinitionId };
   367	
   368	    const itemId = await ensureDefinitionItem(ctx, parsed.data.name, componentRow.output_uom ?? 'kg');
   369	    const inserted = await ctx.client.query<{ id: string }>(
   370	      `insert into public.wip_definitions
   371	         (org_id, item_id, name, base_uom, status, reusable, source_project_id, created_by)
   372	       values
   373	         (app.current_org_id(), $1::uuid, $2, $3, 'active', true, $4::uuid, $5::uuid)
   374	       returning id`,
   375	      [itemId, parsed.data.name, componentRow.output_uom ?? 'kg', componentRow.project_id, ctx.userId],
   376	    );
   377	    const definitionId = inserted.rows[0]?.id;
   378	    if (!definitionId) throw new Error('Could not publish WIP definition');
   379	
   380	    const processes = await ctx.client.query<{
   381	      id: string;
   382	      process_name: string;
   383	      display_order: number;
   384	      duration_hours: string | number;
   385	      additional_cost: string | number;
   386	      throughput_per_hour: string | number | null;
   387	      throughput_uom: string | null;
   388	      setup_cost: string | number;
   389	      yield_pct: string | number;
   390	    }>(
   391	      `select id, process_name, display_order, duration_hours, additional_cost,
   392	              throughput_per_hour, throughput_uom, setup_cost, yield_pct
   393	         from public.npd_wip_processes
   394	        where org_id = app.current_org_id()
   395	          and prod_detail_id = $1::uuid
   396	        order by display_order asc`,
   397	      [parsed.data.prodDetailId],
   398	    );
   399	
   400	    for (const process of processes.rows) {
   401	      const copied = await ctx.client.query<{ id: string }>(
   402	        `insert into public.wip_definition_processes
   403	           (org_id, wip_definition_id, process_name, display_order, duration_hours, additional_cost,
   404	            throughput_per_hour, throughput_uom, setup_cost, yield_pct)
   405	         values
   406	           (app.current_org_id(), $1::uuid, $2, $3::int, $4::numeric, $5::numeric, $6::numeric, $7, $8::numeric, $9::numeric)
   407	         returning id`,
   408	        [
   409	          definitionId,
   410	          process.process_name,
   411	          process.display_order,
   412	          process.duration_hours,
   413	          process.additional_cost,
   414	          process.throughput_per_hour,
   415	          process.throughput_uom,
   416	          process.setup_cost,
   417	          process.yield_pct ?? 100,
   418	        ],
   419	      );
   420	      const copiedId = copied.rows[0]?.id;
