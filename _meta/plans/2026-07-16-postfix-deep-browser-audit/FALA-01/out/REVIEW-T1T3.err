  1021	  // Re-seed the editable state when the LOADED version changes. The selector
  1022	  // navigates to ?version=<id>; a soft navigation re-renders the RSC with the new
  1023	  // version's data but does NOT remount this client island, so the `useState`
  1024	  // initializers above do not re-run. Without this the editor would keep the
  1025	  // previous version's rows on screen while saveDraft writes to the
  1026	  // newly-loaded version — the exact display≠save-target corruption this fix
  1027	  // closes. Keyed on the loaded versionId, so an ordinary save (same version,
  1028	  // refreshed data) never clobbers in-flight edits — only a real version switch
  1029	  // re-seeds.
  1030	  const seededVersionRef = React.useRef<string>(data?.versionId ?? '');
  1031	  React.useEffect(() => {
  1032	    const loadedVersionId = data?.versionId ?? '';
  1033	    if (loadedVersionId === seededVersionRef.current) return;
  1034	    seededVersionRef.current = loadedVersionId;
  1035	    if (timerRef.current) clearTimeout(timerRef.current);
