    82	    return { error: 'password_min_length_floor' };
    83	  }
    84	
    85	  const mfaRequirement = input.mfa_requirement ?? 'optional';
    86	  if (!['off', 'optional', 'required_admins', 'required_all'].includes(mfaRequirement)) {
    87	    return { error: 'invalid_input' };
    88	  }
    89	
    90	  const passwordComplexity = input.password_complexity ?? 'standard';
    91	  if (!['standard', 'strong'].includes(passwordComplexity)) {
    92	    return { error: 'invalid_input' };
    93	  }
    94	
    95	  return {
    96	    input: {
    97	      dual_control_required: input.dual_control_required ?? true,
    98	      mfa_requirement: mfaRequirement,
    99	      mfa_allowed_methods: mfaAllowedMethods,
   100	      password_min_length: passwordMinLength,
   101	      password_complexity: passwordComplexity,
   102	    },
   103	  };
   104	}
