    35	type QueryResult<T = Record<string, unknown>> = { rows: T[]; rowCount?: number | null };
    36	type QueryClient = {
    37	  query<T = Record<string, unknown>>(sql: string, params?: readonly unknown[]): Promise<QueryResult<T>>;
    38	};
    39	type OrgContextLike = { userId: string; orgId: string; client: QueryClient };
    40	type ActionResult<T extends Record<string, unknown> = Record<string, unknown>> =
    41	  | ({ ok: true } & T)
    42	  | { ok: false; error: string; code?: string; status?: number };
