    15	/**
    16	 * When an org has already completed onboarding, invited/member users still carry
    17	 * a JWT without onboarding_completed_at (only the completing admin was stamped).
    18	 * Sync the org timestamp onto the auth user so middleware admits them to the app.
    19	 */
    20	export async function syncUserOnboardingClaimFromOrg(userId: string): Promise<boolean> {
    21	  const owner = getOwnerPool();
    22	  const { rows } = await owner.query<OwnerRow>(
    23	    `select o.onboarding_completed_at
    24	       from public.users u
    25	       join public.organizations o on o.id = u.org_id
    26	      where u.id = $1::uuid
    27	      limit 1`,
    28	    [userId],
    29	  );
    30	  const completedAt = toIsoString(rows[0]?.onboarding_completed_at);
    31	  if (!completedAt) return true;
    32	  return stampOnboardingClaim(userId, completedAt);
    33	}
