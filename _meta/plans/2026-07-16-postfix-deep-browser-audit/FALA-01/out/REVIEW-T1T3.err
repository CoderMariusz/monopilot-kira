   316	     insert into public.user_sites (user_id, site_id, org_id, assigned_by)
   317	     values ($1::uuid, $2::uuid, app.current_org_id(), $3::uuid)
   318	     returning site_id`,
   319	    [targetUserId, siteId, assignedBy],
   320	  );
   321	  return (result.rowCount ?? result.rows.length) >= 1;
