   396	export type GateBlocker = {
   397	  code:
   398	    | 'FG_CANDIDATE_REQUIRED'
   399	    | 'FG_ALREADY_LINKED'
   400	    | 'RECIPE_INGREDIENTS_REQUIRED'
   401	    | 'LAUNCH_COMPLIANCE_BLOCKED'
   402	    | 'REQUIRED_EVIDENCE_MISSING';
   403	  message: string;
