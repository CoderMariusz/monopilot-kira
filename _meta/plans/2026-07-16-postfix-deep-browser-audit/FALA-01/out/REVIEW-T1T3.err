   723	/**
   724	 * Persist a stage transition. `current_stage` is authoritative; `current_gate` is
   725	 * DERIVED via GATE_BY_STAGE so all gate-keyed infra stays in sync. The 'launched'
   726	 * terminal stage maps to gate 'Launched'.
   727	 */
   728	export async function updateProjectStage(
   729	  ctx: OrgContextLike,
   730	  projectId: string,
   731	  targetStage: AnyStage,
   732	): Promise<void> {
   733	  await ctx.client.query(
   734	    `update public.npd_projects
   735	        set current_stage = $2,
   736	            current_gate = $3
   737	      where id = $1::uuid
