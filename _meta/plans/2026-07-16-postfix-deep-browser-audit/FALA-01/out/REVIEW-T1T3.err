    97	// Pool tuning rationale (2026-06-25 pool-EXHAUSTION fix — supersedes the 06-24
    98	// idle-timeout-only tuning, which was insufficient):
    99	//   ROOT CAUSE: on Vercel the lambda FREEZES between invocations, so the JS
   100	//   event loop stops and pg's `idleTimeoutMillis` timer NEVER FIRES while frozen
   101	//   — a warm-but-frozen lambda keeps up to `max` connections open on the
   102	//   SESSION-mode Supavisor pooler (pool_size=15). With the old default max:10 on
   103	//   BOTH the app and owner pools, ONE frozen lambda could pin ~20 client slots;
   104	//   a few lambdas exhausted the 15-slot pool → EMAXCONNSESSION → the whole app
   105	//   shell degraded ("Live data unavailable", nav collapses to Dashboard).
   106	//   FIX: cap each pool small so a frozen lambda's footprint stays within budget.
   107	//     - appPool max:4  — enough for the project-detail ~5-7-way fan-out to run
   108	//       mostly-parallel (the rest queue briefly, well under connectionTimeout);
   109	//       the heaviest fan-out (/reporting) was already collapsed to ONE
   110	//       withOrgContext via reportingBundle (#64).
   111	//     - ownerPool max:2 — owner queries are single autocommit statements
   112	//       (register/delete session_org_contexts, users lookup), held for ms only.
   113	//   DURABLE FIX (owner / Vercel-env action, NOT code): point DATABASE_URL_APP /
   114	//   DATABASE_URL_OWNER at the TRANSACTION-mode pooler (port 6543) — it
   115	//   multiplexes a server connection per-transaction, so pool_size 15 supports
   116	//   far more concurrent clients. The app is compatible: app.set_org_context runs
   117	//   INSIDE the begin/commit txn, and all owner queries are single statements.
   118	//   connectionTimeoutMillis: fail fast (clear error) instead of hanging when the
   119	//   pooler is saturated. idleTimeoutMillis: drain fast when the lambda IS awake.
   120	const APP_POOL_MAX = 4;
   121	const OWNER_POOL_MAX = 2;
   122	const POOL_TUNING = { idleTimeoutMillis: 5_000, connectionTimeoutMillis: 8_000 } as const;
   123	
   124	/**
   125	 * Owner (BYPASSRLS) pool. Exported so the site-context composition
   126	 * (`apps/web/lib/auth/with-site-context.ts`) can register its own
   127	 * `app.session_site_contexts` rows on the SAME privileged pool rather than
   128	 * opening a second owner pool — the trust tables are revoked from app_user, so
   129	 * this INSERT cannot run on the app-role pool. Do NOT use this for data-plane
   130	 * reads/writes: it bypasses RLS by design.
   131	 */
   132	export function getOwnerPool(): pg.Pool {
   133	  if (ownerPool) return ownerPool;
   134	  const cs = process.env.DATABASE_URL_OWNER ?? process.env.DATABASE_URL;
   135	  if (!cs) {
   136	    throw new Error('withOrgContext requires DATABASE_URL_OWNER or DATABASE_URL');
   137	  }
   138	  ownerPool = new Pool({ connectionString: cs, max: OWNER_POOL_MAX, ...POOL_TUNING });
   139	  return ownerPool;
   140	}
   141	
   142	function getAppPool(): pg.Pool {
   143	  if (appPool) return appPool;
   144	  const cs = process.env.DATABASE_URL_APP ?? process.env.DATABASE_URL;
   145	  if (!cs) {
   146	    throw new Error('withOrgContext requires DATABASE_URL_APP or DATABASE_URL');
   147	  }
   148	  // Mirror packages/db/src/clients.ts: when DATABASE_URL_APP is unset (test
   149	  // environment), rewrite the username to app_user so RLS engages.
   150	  const url = new URL(cs);
   151	  if (!process.env.DATABASE_URL_APP) {
   152	    url.username = 'app_user';
   153	    url.password = process.env.APP_USER_PASSWORD ?? 'app-user-test-password';
   154	  }
   155	  appPool = new Pool({ connectionString: url.toString(), max: APP_POOL_MAX, ...POOL_TUNING });
   156	  return appPool;
   157	}
