   940	  for (const process of processes) {
     1	/**
     2	 * 03-technical BOM create (T-013) — cycle / self-reference detection (V-TEC-13).
     3	 *
     4	 * Pure, DB-free graph logic so it is unit-testable in isolation. The Server Action
     5	 * resolves the active-BOM component graph for the caller's org under RLS and hands
     6	 * it to `detectCycle` as a plain adjacency map (parent product_code → component
     7	 * product_codes). Adding the new BOM's parent → its component edges must NOT create
     8	 * a cycle reachable back to the parent.
     9	 *
    10	 * - Self-reference (a line component == the parent) is rejected early (a 1-node cycle).
    11	 * - A path parent → … → parent over ACTIVE BOMs is a cycle (DFS).
    12	 */
    13	
    14	export type BomGraph = Map<string, Set<string>>;
    15	
    16	/** Build an adjacency map from `{ parent, component }` edge rows. */
    17	export function buildGraph(edges: ReadonlyArray<{ parent: string; component: string }>): BomGraph {
    18	  const graph: BomGraph = new Map();
    19	  for (const { parent, component } of edges) {
    20	    if (!graph.has(parent)) graph.set(parent, new Set());
    21	    graph.get(parent)!.add(component);
    22	  }
    23	  return graph;
    24	}
    25	
    26	/**
    27	 * Returns true when introducing edges `parent → component` (for each component in
    28	 * `newComponents`) would create a cycle in `existing` (i.e. some component can
    29	 * already reach `parent`), OR when a component equals `parent` (self-reference).
    30	 */
    31	export function detectCycle(
    32	  existing: BomGraph,
    33	  parent: string,
    34	  newComponents: ReadonlyArray<string>,
    35	): boolean {
    36	  for (const component of newComponents) {
    37	    // Self-reference: a 1-node cycle (V-TEC-13 early reject).
    38	    if (component === parent) return true;
    39	    // If `component` can already reach `parent` over active BOMs, the new edge closes a loop.
    40	    if (reaches(existing, component, parent)) return true;
    41	  }
    42	  return false;
    43	}
    44	
    45	/** DFS: can `from` reach `target` following edges in `graph`? */
    46	function reaches(graph: BomGraph, from: string, target: string): boolean {
    47	  const stack: string[] = [from];
    48	  const seen = new Set<string>();
    49	  while (stack.length > 0) {
    50	    const node = stack.pop()!;
    51	    if (node === target) return true;
    52	    if (seen.has(node)) continue;
    53	    seen.add(node);
    54	    const next = graph.get(node);
    55	    if (next) for (const n of next) if (!seen.has(n)) stack.push(n);
    56	  }
    57	  return false;
    58	}
