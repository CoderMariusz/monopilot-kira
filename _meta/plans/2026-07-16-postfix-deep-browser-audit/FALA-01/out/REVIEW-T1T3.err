   161	  await owner.query(`delete from public.gate_approvals where org_id in ($1, $2)`, [seed.orgAId, seed.orgBId]);
   162	  await owner.query(`delete from public.formulation_ingredients where version_id = $1`, [formulationVersionId]);
   163	  await owner.query(`delete from public.formulations where org_id in ($1, $2)`, [seed.orgAId, seed.orgBId]);
