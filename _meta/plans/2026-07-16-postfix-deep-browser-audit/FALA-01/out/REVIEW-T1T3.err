    45	const MAX_DEPTH = 3;
    46	const PG_UNDEFINED_TABLE = '42P01';
    47	const BOM_CASCADE_LOAD_FAILED = 'BOM_CASCADE_LOAD_FAILED';
    48	
    49	export async function loadRecipeCascade(
    50	  projectId: string,
    51	  formulationVersionId: string,
    52	): Promise<RecipeCascadeNode[]> {
    53	  if (!parseUuid(projectId) || !parseUuid(formulationVersionId)) return [];
    54	
    55	  try {
    56	    return await withOrgContext(async ({ client }) => {
    57	      const ingredients = await client.query<IngredientLineRow>(
    58	        `select fi.id::text as ingredient_line_id,
    59	                fi.item_id::text as item_id,
    60	                i.item_code,
    61	                i.name as item_name
    62	           from public.formulations f
    63	           join public.formulation_versions fv
    64	             on fv.formulation_id = f.id
    65	            and fv.id = $2::uuid
    66	           join public.formulation_ingredients fi
    67	             on fi.version_id = fv.id
    68	           left join public.items i
    69	             on i.id = fi.item_id
    70	            and i.org_id = app.current_org_id()
    71	          where f.project_id = $1::uuid
    72	            and f.org_id = app.current_org_id()
    73	          order by fi.sequence`,
    74	        [projectId, formulationVersionId],
    75	      );
    76	
    77	      const nodes: RecipeCascadeNode[] = [];
    78	      for (const ingredient of ingredients.rows) {
    79	        const itemCode = ingredient.item_code ?? '';
    80	        const itemName = ingredient.item_name ?? itemCode;
    81	        const subRecipe =
    82	          itemCode || ingredient.item_id
    83	            ? await loadSubRecipe(client, itemCode, 1, new Set(itemCode ? [itemCode] : []), ingredient.item_id)
    84	            : undefined;
    85	        nodes.push({
    86	          ingredientLineId: ingredient.ingredient_line_id,
    87	          itemCode,
    88	          itemName,
    89	          hasSubRecipe: Boolean(subRecipe),
    90	          ...(subRecipe ? { subRecipe } : {}),
    91	        });
    92	      }
    93	      return nodes;
    94	    });
    95	  } catch (err) {
    96	    // BOM fallback failures must not collapse into a silent empty cascade.
    97	    if ((err as { code?: string })?.code === BOM_CASCADE_LOAD_FAILED) throw err;
    98	    return [];
    99	  }
   100	}
   101	
   102	async function loadSubRecipe(
   103	  client: QueryClient,
   104	  itemCode: string,
   105	  depth: number,
   106	  visited: Set<string>,
   107	  itemId?: string | null,
   108	): Promise<RecipeCascadeSubRecipe | undefined> {
   109	  const version = itemCode ? await findActiveRecipeVersion(client, itemCode) : null;
   110	  if (version) {
   111	    if (depth > MAX_DEPTH) {
   112	      return { lines: [], totalCost: 0, maxDepthReached: true };
   113	    }
   114	    return loadFormulationSubRecipe(client, version.version_id, depth, visited);
   115	  }
   116	
   117	  // WIP/intermediate: prefer ACTIVE bom-with-lines; else active wip_definition_ingredients.
   118	  if (!itemId) return undefined;
   119	
   120	  if (depth > MAX_DEPTH) {
   121	    if (await hasExpandableSubRecipe(client, itemCode, itemId)) {
   122	      return { lines: [], totalCost: 0, maxDepthReached: true };
   123	    }
   124	    return undefined;
   125	  }
   126	
   127	  const bom = await loadBomSubRecipe(client, itemId, depth, visited);
   128	  if (bom) return bom;
   129	  return loadWipDefinitionSubRecipe(client, itemId, depth, visited);
   130	}
   131	
   132	async function hasExpandableSubRecipe(
   133	  client: QueryClient,
   134	  itemCode: string,
   135	  itemId: string,
   136	): Promise<boolean> {
   137	  if (itemCode && (await findActiveRecipeVersion(client, itemCode))) return true;
   138	  const bom = await loadBomComponents(client, itemId);
   139	  if (bom.rows.length > 0) return true;
   140	  const wipDef = await loadWipDefinitionComponents(client, itemId);
   141	  return wipDef.rows.length > 0;
   142	}
   143	
   144	async function loadFormulationSubRecipe(
   145	  client: QueryClient,
   146	  versionId: string,
   147	  depth: number,
   148	  visited: Set<string>,
   149	): Promise<RecipeCascadeSubRecipe> {
   150	  const components = await loadRecipeComponents(client, versionId);
   151	  const lines: RecipeCascadeSubLine[] = [];
   152	  let totalCost = 0;
   153	
   154	  for (const component of components.rows) {
   155	    const componentCode = component.item_code ?? '';
   156	    const pct = toNumber(component.pct);
   157	    const unitCost = toNumber(component.unit_cost);
   158	    const qtyKg = toNumber(component.qty_kg);
   159	    totalCost += unitCost * qtyKg;
   160	
   161	    const nutritionPer100g = normalizeNutrition(component.nutrition_per_100g);
   162	    const line: RecipeCascadeSubLine = {
   163	      itemCode: componentCode,
   164	      itemName: component.item_name ?? componentCode,
   165	      pct,
   166	      unitCost,
   167	      ...(nutritionPer100g ? { nutritionPer100g } : {}),
   168	    };
   169	
   170	    await attachNestedSubRecipe(client, line, componentCode, component.item_id, depth, visited);
   171	    lines.push(line);
   172	  }
   173	
   174	  return { lines, totalCost };
   175	}
   176	
   177	async function loadBomSubRecipe(
   178	  client: QueryClient,
   179	  itemId: string,
   180	  depth: number,
   181	  visited: Set<string>,
   182	): Promise<RecipeCascadeSubRecipe | undefined> {
   183	  const components = await loadBomComponents(client, itemId);
   184	  if (components.rows.length === 0) return undefined;
   185	  return buildQtyBasedSubRecipe(client, components.rows, depth, visited);
   186	}
   187	
   188	/** ACTIVE wip_definitions recipe via wip_definition_ingredients (pre-materialisation source). */
   189	async function loadWipDefinitionSubRecipe(
   190	  client: QueryClient,
   191	  itemId: string,
   192	  depth: number,
   193	  visited: Set<string>,
   194	): Promise<RecipeCascadeSubRecipe | undefined> {
   195	  const components = await loadWipDefinitionComponents(client, itemId);
   196	  if (components.rows.length === 0) return undefined;
   197	  return buildQtyBasedSubRecipe(client, components.rows, depth, visited);
   198	}
   199	
   200	async function buildQtyBasedSubRecipe(
   201	  client: QueryClient,
   202	  rows: BomComponentRow[],
   203	  depth: number,
   204	  visited: Set<string>,
   205	): Promise<RecipeCascadeSubRecipe> {
   206	  const qtyValues = rows.map((row) => toNumber(row.qty_kg));
   207	  const qtySum = qtyValues.reduce((sum, qty) => sum + qty, 0);
   208	
   209	  const lines: RecipeCascadeSubLine[] = [];
   210	  let totalCost = 0;
   211	
   212	  for (let i = 0; i < rows.length; i++) {
   213	    const component = rows[i]!;
   214	    const componentCode = component.item_code ?? '';
   215	    const qtyKg = qtyValues[i] ?? 0;
   216	    const unitCost = toNumber(component.unit_cost);
   217	    totalCost += unitCost * qtyKg;
   218	
   219	    const nutritionPer100g = normalizeNutrition(component.nutrition_per_100g);
   220	    const line: RecipeCascadeSubLine = {
   221	      itemCode: componentCode,
   222	      itemName: component.item_name ?? componentCode,
   223	      pct: qtySum > 0 ? (qtyKg / qtySum) * 100 : 0,
   224	      unitCost,
   225	      ...(nutritionPer100g ? { nutritionPer100g } : {}),
   226	    };
   227	
   228	    await attachNestedSubRecipe(client, line, componentCode, component.item_id, depth, visited);
   229	    lines.push(line);
   230	  }
   231	
   232	  return { lines, totalCost };
   233	}
   234	
   235	async function attachNestedSubRecipe(
   236	  client: QueryClient,
   237	  line: RecipeCascadeSubLine,
   238	  componentCode: string,
   239	  componentItemId: string | null | undefined,
   240	  depth: number,
   241	  visited: Set<string>,
   242	): Promise<void> {
   243	  if (!componentCode && !componentItemId) return;
   244	
   245	  const visitKey = componentCode || `id:${componentItemId}`;
   246	  if (visited.has(visitKey) || (componentCode && visited.has(componentCode))) {
   247	    line.hasSubRecipe = true;
   248	    line.subRecipe = { lines: [], totalCost: 0, cycle: true };
   249	    return;
   250	  }
   251	
   252	  const nextVisited = new Set(visited);
   253	  nextVisited.add(visitKey);
   254	  if (componentCode) nextVisited.add(componentCode);
   255	
   256	  const child = await loadSubRecipe(client, componentCode, depth + 1, nextVisited, componentItemId);
   257	  if (child) {
   258	    line.hasSubRecipe = true;
   259	    line.subRecipe = child;
   260	  }
   261	}
   262	
   263	async function findActiveRecipeVersion(client: QueryClient, itemCode: string): Promise<RecipeVersionRow | null> {
   264	  const result = await client.query<RecipeVersionRow>(
   265	    `select fv.id::text as version_id
   266	       from public.formulations f
   267	       join public.formulation_versions fv
   268	         on fv.formulation_id = f.id
   269	      where f.org_id = app.current_org_id()
   270	        and f.product_code = $1::text
   271	        and fv.state in ('locked', 'active')
   272	      order by (fv.id = f.current_version_id) desc,
   273	               fv.version_number desc
   274	      limit 1`,
   275	    [itemCode],
   276	  );
   277	  return result.rows[0] ?? null;
   278	}
   279	
   280	async function loadRecipeComponents(client: QueryClient, versionId: string): Promise<{ rows: RecipeComponentRow[] }> {
   281	  try {
   282	    return await client.query<RecipeComponentRow>(
   283	      `select i.id::text as item_id,
   284	              coalesce(i.item_code, fi.rm_code) as item_code,
   285	              coalesce(i.name, fi.rm_code) as item_name,
   286	              fi.pct::text,
   287	              fi.qty_kg::text,
   288	              vec.amount::text as unit_cost,
   289	              rm.nutrition_per_100g
   290	         from public.formulation_ingredients fi
   291	         left join public.items i
   292	           on i.id = fi.item_id
   293	          and i.org_id = app.current_org_id()
   294	         left join public.v_item_effective_cost vec
   295	           on vec.item_id = i.id
   296	          and vec.org_id = app.current_org_id()
   297	         left join "Reference"."RawMaterials" rm
   298	           on rm.org_id = app.current_org_id()
   299	          and rm.rm_code = coalesce(i.item_code, fi.rm_code)
   300	        where fi.version_id = $1::uuid
   301	        order by fi.sequence`,
   302	      [versionId],
   303	    );
   304	  } catch (err) {
   305	    if ((err as { code?: string })?.code !== PG_UNDEFINED_TABLE) throw err;
   306	    return await client.query<RecipeComponentRow>(
   307	      `select i.id::text as item_id,
   308	              coalesce(i.item_code, fi.rm_code) as item_code,
   309	              coalesce(i.name, fi.rm_code) as item_name,
   310	              fi.pct::text,
   311	              fi.qty_kg::text,
   312	              vec.amount::text as unit_cost,
   313	              null::jsonb as nutrition_per_100g
   314	         from public.formulation_ingredients fi
   315	         left join public.items i
   316	           on i.id = fi.item_id
   317	          and i.org_id = app.current_org_id()
   318	         left join public.v_item_effective_cost vec
   319	           on vec.item_id = i.id
   320	          and vec.org_id = app.current_org_id()
   321	        where fi.version_id = $1::uuid
   322	        order by fi.sequence`,
   323	      [versionId],
   324	    );
   325	  }
   326	}
   327	
   328	/**
   329	 * Active wip_definition ingredients by item_id — canonical NPD WIP recipe before BOM
   330	 * materialisation. qty_per_unit maps to qty_kg for pct/cost roll-up.
   331	 */
   332	async function loadWipDefinitionComponents(
   333	  client: QueryClient,
   334	  wipItemId: string,
   335	): Promise<{ rows: BomComponentRow[] }> {
   336	  try {
   337	    return await client.query<BomComponentRow>(
   338	      `select wdi.item_id::text as item_id,
   339	              i.item_code,
   340	              coalesce(i.name, i.item_code) as item_name,
   341	              wdi.qty_per_unit::text as qty_kg,
   342	              vec.amount::text as unit_cost,
   343	              rm.nutrition_per_100g
   344	         from public.wip_definitions wd
   345	         join public.wip_definition_ingredients wdi
   346	           on wdi.wip_definition_id = wd.id
   347	          and wdi.org_id = wd.org_id
   348	         join public.items i
   349	           on i.id = wdi.item_id
   350	          and i.org_id = app.current_org_id()
   351	         left join public.v_item_effective_cost vec
   352	           on vec.item_id = wdi.item_id
   353	          and vec.org_id = app.current_org_id()
   354	         left join "Reference"."RawMaterials" rm
   355	           on rm.org_id = app.current_org_id()
   356	          and rm.rm_code = i.item_code
   357	        where wd.org_id = app.current_org_id()
   358	          and wd.item_id = $1::uuid
   359	          and wd.status = 'active'
   360	        order by wdi.sequence, i.item_code`,
   361	      [wipItemId],
   362	    );
   363	  } catch (err) {
   364	    if ((err as { code?: string })?.code !== PG_UNDEFINED_TABLE) throw err;
   365	    // ponytail: RawMaterials may be absent in some test/envs; cost/name still resolve.
   366	    return await client.query<BomComponentRow>(
   367	      `select wdi.item_id::text as item_id,
   368	              i.item_code,
   369	              coalesce(i.name, i.item_code) as item_name,
   370	              wdi.qty_per_unit::text as qty_kg,
   371	              vec.amount::text as unit_cost,
   372	              null::jsonb as nutrition_per_100g
   373	         from public.wip_definitions wd
   374	         join public.wip_definition_ingredients wdi
   375	           on wdi.wip_definition_id = wd.id
   376	          and wdi.org_id = wd.org_id
   377	         join public.items i
   378	           on i.id = wdi.item_id
   379	          and i.org_id = app.current_org_id()
   380	         left join public.v_item_effective_cost vec
   381	           on vec.item_id = wdi.item_id
   382	          and vec.org_id = app.current_org_id()
   383	        where wd.org_id = app.current_org_id()
   384	          and wd.item_id = $1::uuid
   385	          and wd.status = 'active'
   386	        order by wdi.sequence, i.item_code`,
   387	      [wipItemId],
   388	    );
   389	  }
   390	}
   391	
   392	/** Exact pattern of technical/bom loadWipSubBom — ACTIVE header by item_id — plus cost/name for cascade. */
   393	async function loadBomComponents(client: QueryClient, wipItemId: string): Promise<{ rows: BomComponentRow[] }> {
   394	  try {
   395	    try {
   396	      return await client.query<BomComponentRow>(
   397	        `select bl.item_id::text as item_id,
   398	                bl.component_code as item_code,
   399	                coalesce(i.name, bl.component_code) as item_name,
   400	                bl.quantity::text as qty_kg,
   401	                vec.amount::text as unit_cost,
   402	                rm.nutrition_per_100g
   403	           from public.bom_lines bl
   404	           join public.bom_headers h
   405	             on h.id = bl.bom_header_id and h.org_id = bl.org_id
   406	           left join public.items i
   407	             on i.id = bl.item_id and i.org_id = bl.org_id
   408	           left join public.v_item_effective_cost vec
   409	             on vec.item_id = bl.item_id
   410	            and vec.org_id = app.current_org_id()
   411	           left join "Reference"."RawMaterials" rm
   412	             on rm.org_id = app.current_org_id()
   413	            and rm.rm_code = bl.component_code
   414	          where bl.org_id = app.current_org_id()
   415	            and h.org_id = app.current_org_id()
   416	            and h.item_id = $1::uuid
   417	            and h.status = 'active'
   418	          order by bl.line_no asc`,
   419	        [wipItemId],
   420	      );
     1	import { beforeEach, describe, expect, it, vi } from 'vitest';
     2	
     3	import { loadRecipeCascade } from './load-recipe-cascade';
     4	
     5	type QueryClient = {
     6	  query<T = Record<string, unknown>>(
     7	    sql: string,
     8	    params?: readonly unknown[],
     9	  ): Promise<{ rows: T[] }>;
    10	};
    11	
    12	const PROJECT_ID = '11111111-1111-4111-8111-111111111111';
    13	const VERSION_ID = '22222222-2222-4222-8222-222222222222';
    14	const USER_ID = '33333333-3333-4333-8333-333333333333';
    15	const ORG_ID = '44444444-4444-4444-8444-444444444444';
    16	const WIP_ITEM_ID = '55555555-5555-4555-8555-555555555555';
    17	const NESTED_WIP_ITEM_ID = '66666666-6666-4666-8666-666666666666';
    18	
    19	let client: QueryClient;
    20	let rootCode = 'WIP-A';
    21	let rootItemId: string | null = null;
    22	let versionsByCode: Record<string, string>;
    23	let componentsByVersion: Record<string, Array<Record<string, unknown>>>;
    24	let bomLinesByItemId: Record<string, Array<Record<string, unknown>>>;
    25	let wipDefLinesByItemId: Record<string, Array<Record<string, unknown>>>;
    26	let queries: string[];
    27	let bomShouldFail = false;
    28	
    29	vi.mock('../../../../../../lib/auth/with-org-context', () => ({
    30	  withOrgContext: vi.fn(
    31	    async (action: (ctx: { userId: string; orgId: string; client: QueryClient }) => Promise<unknown>) =>
    32	      action({ userId: USER_ID, orgId: ORG_ID, client }),
    33	  ),
    34	}));
    35	
    36	function normalize(sql: string): string {
    37	  return sql.replace(/\s+/g, ' ').trim().toLowerCase();
    38	}
    39	
    40	function makeClient(): QueryClient {
    41	  return {
    42	    query: vi.fn(async (sql: string, params?: readonly unknown[]) => {
    43	      const q = normalize(sql);
    44	      queries.push(q);
    45	      if (q.includes('join public.formulation_versions fv') && q.includes('join public.formulation_ingredients fi')) {
    46	        return {
    47	          rows: [
    48	            {
    49	              ingredient_line_id: 'line-root',
    50	              item_id: rootItemId,
    51	              item_code: rootCode,
    52	              item_name: rootCode,
    53	            },
    54	          ],
    55	        };
    56	      }
    57	      if (q.includes('f.product_code = $1::text')) {
    58	        const itemCode = String(params?.[0] ?? '');
    59	        const version = versionsByCode[itemCode];
    60	        return { rows: version ? [{ version_id: version }] : [] };
    61	      }
    62	      if (q.includes('from public.formulation_ingredients fi')) {
    63	        const versionId = String(params?.[0] ?? '');
    64	        return { rows: componentsByVersion[versionId] ?? [] };
    65	      }
    66	      if (q.includes('from public.bom_lines bl') && q.includes("h.status = 'active'")) {
    67	        if (bomShouldFail) {
    68	          throw Object.assign(new Error('bom boom'), { code: 'XX000' });
    69	        }
    70	        const itemId = String(params?.[0] ?? '');
    71	        return { rows: bomLinesByItemId[itemId] ?? [] };
    72	      }
    73	      if (
    74	        q.includes('from public.wip_definitions wd') &&
    75	        q.includes('join public.wip_definition_ingredients wdi') &&
    76	        q.includes("wd.status = 'active'")
    77	      ) {
    78	        const itemId = String(params?.[0] ?? '');
    79	        return { rows: wipDefLinesByItemId[itemId] ?? [] };
    80	      }
    81	      throw new Error(`unexpected query: ${q}`);
    82	    }),
    83	  };
    84	}
    85	
    86	beforeEach(() => {
    87	  queries = [];
    88	  rootCode = 'WIP-A';
    89	  rootItemId = null;
    90	  versionsByCode = {};
    91	  componentsByVersion = {};
    92	  bomLinesByItemId = {};
    93	  wipDefLinesByItemId = {};
    94	  bomShouldFail = false;
    95	  client = makeClient();
    96	});
    97	
    98	describe('loadRecipeCascade', () => {
    99	  it('does not mark terminal leaves as max-depth failures', async () => {
   100	    rootCode = 'WIP-20260714-0011';
   101	    rootItemId = WIP_ITEM_ID;
   102	    wipDefLinesByItemId = {
   103	      [WIP_ITEM_ID]: [
   104	        bomLine('flour-id', 'ING-FLOUR', 'Flour', '0.70', '1.0'),
   105	        bomLine('sugar-id', 'ING-SUGAR', 'Sugar', '0.10', '2.0'),
   106	        bomLine('butter-id', 'RM-BUTTER', 'Butter', '0.20', '3.0'),
   107	      ],
   108	    };
   109	
   110	    const result = await loadRecipeCascade(PROJECT_ID, VERSION_ID);
   111	    const leaves = result[0]?.subRecipe?.lines ?? [];
   112	
   113	    expect(leaves).toHaveLength(3);
   114	    for (const leaf of leaves) {
   115	      expect(leaf.hasSubRecipe).toBeFalsy();
   116	      expect(leaf.subRecipe).toBeUndefined();
   117	    }
   118	    expect(JSON.stringify(result)).not.toContain('maxDepthReached');
   119	  });
   120	
   121	  it('stops recursive expansion at depth 3', async () => {
   122	    versionsByCode = {
   123	      'WIP-A': 'version-a',
   124	      'WIP-B': 'version-b',
   125	      'WIP-C': 'version-c',
   126	    };
   127	    componentsByVersion = {
   128	      'version-a': [line('WIP-B', 'Blend B', '50', '0.5', '2')],
   129	      'version-b': [line('WIP-C', 'Blend C', '25', '0.25', '3')],
   130	      'version-c': [line('RM-D', 'Raw D', '10', '0.1', '4')],
   131	    };
   132	
   133	    const result = await loadRecipeCascade(PROJECT_ID, VERSION_ID);
   134	
   135	    const first = result[0]?.subRecipe?.lines[0];
   136	    const second = first?.subRecipe?.lines[0];
   137	    expect(second?.subRecipe).toMatchObject({ maxDepthReached: true, lines: [] });
   138	    expect(queries.filter((q) => q.includes('where fi.version_id = $1::uuid'))).toHaveLength(2);
   139	  });
   140	
   141	  it('marks a repeated item code as a cycle', async () => {
   142	    versionsByCode = { 'WIP-A': 'version-a' };
   143	    componentsByVersion = {
   144	      'version-a': [line('WIP-A', 'Blend A again', '100', '1', '1')],
   145	    };
   146	
   147	    const result = await loadRecipeCascade(PROJECT_ID, VERSION_ID);
   148	
   149	    expect(result[0]?.subRecipe?.lines[0]?.subRecipe).toMatchObject({ cycle: true, lines: [] });
   150	  });
   151	
   152	  it('reads unit cost from public.v_item_effective_cost', async () => {
   153	    versionsByCode = { 'WIP-A': 'version-a' };
   154	    componentsByVersion = {
   155	      'version-a': [line('RM-1', 'Raw 1', '100', '2', '1.23', { protein_g: '12' })],
   156	    };
   157	
   158	    const result = await loadRecipeCascade(PROJECT_ID, VERSION_ID);
   159	
   160	    expect(result[0]?.subRecipe?.lines[0]).toMatchObject({
   161	      itemCode: 'RM-1',
   162	      unitCost: 1.23,
   163	      nutritionPer100g: { protein_g: 12 },
   164	    });
   165	    expect(result[0]?.subRecipe?.totalCost).toBe(2.46);
   166	    expect(queries.some((q) => q.includes('public.v_item_effective_cost'))).toBe(true);
   167	  });
   168	
   169	  it('falls back to ACTIVE BOM when an intermediate has no formulations row', async () => {
   170	    rootCode = 'WIP-20260714-0011';
   171	    rootItemId = WIP_ITEM_ID;
   172	    // no versionsByCode entry → formulations miss
   173	    bomLinesByItemId = {
   174	      [WIP_ITEM_ID]: [
   175	        bomLine('rm-1', 'RM-MILK', 'Milk powder', '60', '1.5', { protein_g: 20 }),
   176	        bomLine(NESTED_WIP_ITEM_ID, 'WIP-NEST', 'Nested blend', '40', '2.0'),
   177	      ],
   178	      [NESTED_WIP_ITEM_ID]: [bomLine('rm-2', 'RM-SUGAR', 'Sugar', '100', '0.5')],
   179	    };
   180	
   181	    const result = await loadRecipeCascade(PROJECT_ID, VERSION_ID);
   182	
   183	    expect(result[0]).toMatchObject({
   184	      itemCode: 'WIP-20260714-0011',
   185	      hasSubRecipe: true,
   186	    });
   187	    expect(result[0]?.subRecipe?.lines).toEqual([
   188	      expect.objectContaining({
   189	        itemCode: 'RM-MILK',
   190	        itemName: 'Milk powder',
   191	        pct: 60,
   192	        unitCost: 1.5,
   193	        nutritionPer100g: { protein_g: 20 },
   194	      }),
   195	      expect.objectContaining({
   196	        itemCode: 'WIP-NEST',
   197	        itemName: 'Nested blend',
   198	        pct: 40,
   199	        unitCost: 2.0,
   200	        hasSubRecipe: true,
   201	      }),
   202	    ]);
   203	    expect(result[0]?.subRecipe?.lines[1]?.subRecipe?.lines).toEqual([
   204	      expect.objectContaining({ itemCode: 'RM-SUGAR', pct: 100, unitCost: 0.5 }),
   205	    ]);
   206	    expect(result[0]?.subRecipe?.totalCost).toBe(60 * 1.5 + 40 * 2.0);
   207	    expect(queries.some((q) => q.includes('from public.bom_lines bl'))).toBe(true);
   208	  });
   209	
   210	  it('surfaces BOM lookup failures instead of returning []', async () => {
   211	    rootCode = 'WIP-FAIL';
   212	    rootItemId = WIP_ITEM_ID;
   213	    bomShouldFail = true;
   214	
   215	    await expect(loadRecipeCascade(PROJECT_ID, VERSION_ID)).rejects.toMatchObject({
   216	      code: 'BOM_CASCADE_LOAD_FAILED',
   217	    });
   218	  });
   219	
   220	  it('falls back to active wip_definition_ingredients when intermediate has no BOM', async () => {
   221	    rootCode = 'WIP-20260714-0011';
   222	    rootItemId = WIP_ITEM_ID;
   223	    // no formulations, no bom_lines → NPD WIP recipe lives on the active definition
   224	    wipDefLinesByItemId = {
   225	      [WIP_ITEM_ID]: [
   226	        bomLine('flour-id', 'ING-FLOUR', 'Flour', '0.70', '1.0'),
   227	        bomLine('sugar-id', 'ING-SUGAR', 'Sugar', '0.10', '2.0'),
   228	        bomLine('butter-id', 'RM-BUTTER', 'Butter', '0.20', '3.0'),
   229	      ],
   230	    };
   231	
   232	    const result = await loadRecipeCascade(PROJECT_ID, VERSION_ID);
   233	
   234	    expect(result[0]).toMatchObject({
   235	      itemCode: 'WIP-20260714-0011',
   236	      hasSubRecipe: true,
   237	    });
   238	    expect(result[0]?.subRecipe?.lines).toEqual([
   239	      expect.objectContaining({ itemCode: 'ING-FLOUR', itemName: 'Flour', pct: 70, unitCost: 1.0 }),
   240	      expect.objectContaining({ itemCode: 'ING-SUGAR', itemName: 'Sugar', pct: 10, unitCost: 2.0 }),
   241	      expect.objectContaining({ itemCode: 'RM-BUTTER', itemName: 'Butter', pct: 20, unitCost: 3.0 }),
   242	    ]);
   243	    expect(result[0]?.subRecipe?.totalCost).toBe(0.7 * 1.0 + 0.1 * 2.0 + 0.2 * 3.0);
   244	    expect(queries.some((q) => q.includes('from public.bom_lines bl'))).toBe(true);
   245	    expect(queries.some((q) => q.includes('join public.wip_definition_ingredients wdi'))).toBe(true);
   246	  });
   247	});
   248	
   249	function line(
   250	  itemCode: string,
   251	  itemName: string,
   252	  pct: string,
   253	  qtyKg: string,
   254	  unitCost: string,
   255	  nutritionPer100g: Record<string, unknown> | null = null,
   256	  itemId: string | null = null,
   257	): Record<string, unknown> {
   258	  return {
   259	    item_id: itemId,
   260	    item_code: itemCode,
