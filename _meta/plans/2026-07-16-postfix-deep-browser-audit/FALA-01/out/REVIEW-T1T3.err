   420	
   421	/** Launch blocks on any required criterion still pending; warns are non-blocking. */
   422	export function launchBlockingCriteria(criteria: ApprovalCriteriaResult): Array<keyof ApprovalCriteriaResult> {
   423	  return (Object.entries(criteria) as Array<[keyof ApprovalCriteriaResult, ApprovalCriterionStatus]>)
   424	    .filter(([, status]) => status === 'pending')
   425	    .map(([key]) => key);
   426	}
   427	
   428	export class GateActionError extends Error {
   429	  code: string;
   430	  status: number;
   431	  blockers: GateBlocker[];
   432	
   433	  constructor(code: string, status = 400, blockers: GateBlocker[] = []) {
   434	    super(code);
   435	    this.name = 'GateActionError';
   436	    this.code = code;
   437	    this.status = status;
   438	    this.blockers = blockers;
   439	  }
   440	}
   441	
   442	// ─── Gate-space navigation primitives (legacy) ───
   443	// The advance engine is now STAGE-native (nextStage / assertAdjacentStage above).
   444	// Gate primitives remain for revert-npd-gate.ts, which reasons in gate space
   445	// (admin rollback to the previous gate), and as the documented gate adjacency rule.
   446	export function nextGate(gate: ProjectGate): ProjectGate | null {
   447	  const index = GATES.indexOf(gate);
   448	  if (index < 0 || index >= GATES.length - 1) return null;
   449	  return GATES[index + 1] ?? null;
   450	}
   451	
   452	export function previousGate(gate: ProjectGate): ProjectGate | null {
   453	  const index = GATES.indexOf(gate);
   454	  if (index <= 0) return null;
   455	  return GATES[index - 1] ?? null;
   456	}
   457	
   458	/** @deprecated Stage advance uses assertAdjacentStage. Kept for gate-space rollback docs. */
   459	export function assertAdjacent(currentGate: ProjectGate, targetGate: ProjectGate): void {
   460	  if (nextGate(currentGate) !== targetGate) {
   461	    throw new GateActionError('ADJACENCY_VIOLATION', 422);
   462	  }
   463	}
   464	
   465	export async function requireActionPermission(ctx: OrgContextLike, permission: string): Promise<void> {
   466	  if (!(await hasPermission(ctx, permission))) {
   467	    throw new GateActionError('FORBIDDEN', 403);
   468	  }
   469	}
   470	
   471	export async function requireAdmin(ctx: OrgContextLike): Promise<void> {
   472	  if (await hasPermission(ctx, ADMIN_PERMISSION)) return;
   473	
   474	  const role = await ctx.client.query<{ ok: boolean }>(
   475	    `select true as ok
   476	       from public.user_roles ur
   477	       join public.roles r on r.id = ur.role_id and r.org_id = ur.org_id
   478	      where ur.user_id = $1::uuid
   479	        and ur.org_id = $2::uuid
   480	        and r.code = 'admin'
   481	      limit 1`,
   482	    [ctx.userId, ctx.orgId],
   483	  );
   484	  if (role.rows.length === 0) throw new GateActionError('FORBIDDEN', 403);
   485	}
   486	
   487	/**
   488	 * G4 e-signature checkpoint guard for the approval → handoff stage transition.
   489	 *
   490	 * Advancing FROM `approval` TO `handoff` is the BRCGS/CFR-21 e-sign checkpoint. The
   491	 * signature itself is collected by the existing approveProjectGate flow (gateCode
   492	 * 'G4', signEvent intent 'npd.gate.approved' → gate_approvals with esigned_at +
   493	 * esign_hash). This guard verifies a valid, immutable G4 e-sign approval exists
   494	 * before allowing the stage to advance — advancing without one throws ESIGN_REQUIRED.
   495	 */
   496	export async function assertG4ESignForHandoff(ctx: OrgContextLike, projectId: string): Promise<void> {
   497	  const { rows } = await ctx.client.query<{ ok: boolean }>(
   498	    `select true as ok
   499	       from public.gate_approvals
   500	      where org_id = app.current_org_id()
   501	        and project_id = $1::uuid
   502	        and gate_code = 'G4'
   503	        and decision = 'approved'
   504	        and esigned_at is not null
   505	        and esign_hash is not null
   506	      limit 1`,
   507	    [projectId],
   508	  );
   509	  if (rows.length === 0) {
   510	    throw new GateActionError('ESIGN_REQUIRED', 403);
   511	  }
