     1	-- T-062 hardening: enable RLS on tenant_idp_config + revoke broad app_user SELECT.
     2	-- Migration 027: lock down tenant_idp_config so secrets (x509_cert, scim_token_hash,
     3	-- entity_id, metadata_url, …) cannot be read directly by the app role. Replaces
     4	-- the broad `grant select` from 025-tenant-idp-config-app-grant.sql with a
     5	-- narrow SECURITY DEFINER reader that exposes only the safe policy fields the
     6	-- app actually needs at request time.
     7	--
     8	-- BEFORE: 025-tenant-idp-config-app-grant.sql granted SELECT to app_user with
     9	--         no RLS (the table was keyed by tenant_id and "scoped by callers").
    10	--         Effect: any app_user could
    11	--           `select x509_cert, scim_token_hash from public.tenant_idp_config`
    12	--         and exfiltrate IdP signing certificates and SCIM token hashes.
    13	--
    14	-- AFTER:  RLS enabled + force; broad SELECT revoked from app_user; app reads
    15	--         go through `app.get_my_tenant_idp_config(p_tenant_id uuid)` which
    16	--         returns ONLY the policy fields needed for SAML enforcement
    17	--         (provider_type, enforce_for_non_admins, jit_provisioning,
    18	--          mfa_required, mfa_required_for_roles, mfa_allowed_methods).
    19	--         Secrets stay control-plane-only.
    20	--
    21	-- Mutation proof:
    22	--   * As app_user before: `SELECT x509_cert FROM public.tenant_idp_config`
    23	--     → returns rows.
    24	--   * As app_user after:  same query → permission denied (no SELECT grant).
    25	--   * `SELECT app.get_my_tenant_idp_config('<tenant>')` returns only the
    26	--     allow-listed policy columns; calling it with a tenant the caller has
    27	--     no current org context for returns NULL (no row).
    28	--
    29	-- Reversibility: dropping the function and re-granting SELECT restores the
    30	-- previous (insecure) state. Documented for completeness; do NOT run in prod.
    31	
    32	-- 1. Lock the table down: enable + force RLS, revoke broad SELECT grant.
    33	alter table public.tenant_idp_config enable row level security;
    34	alter table public.tenant_idp_config force row level security;
    35	revoke select on public.tenant_idp_config from app_user;
    36	
    37	-- 2. Narrow reader function — returns ONLY the safe policy fields that
    38	--    enforceSamlPolicy / SAML route handlers need. Secrets are intentionally
    39	--    excluded (no x509_cert, no scim_token_hash, no metadata_url, no entity_id).
    40	--
    41	--    SECURITY DEFINER: runs with the migration owner's privileges (which has
    42	--    full SELECT on tenant_idp_config) so it can bypass the table-level
    43	--    revoke for the explicitly-allow-listed columns.
    44	--    SET search_path = pg_catalog hardens against search-path injection.
    45	create or replace function app.get_my_tenant_idp_config(p_tenant_id uuid)
    46	returns table (
    47	  tenant_id              uuid,
    48	  provider_type          varchar,
    49	  enforce_for_non_admins boolean,
    50	  jit_provisioning       boolean,
    51	  mfa_required           boolean,
    52	  mfa_required_for_roles text[],
    53	  mfa_allowed_methods    text[],
    54	  password_complexity    varchar,
    55	  idle_timeout_min       int,
    56	  session_max_h          int
    57	)
    58	language plpgsql
    59	security definer
    60	set search_path = pg_catalog
    61	as $$
    62	begin
    63	  -- Only return rows whose tenant_id matches BOTH the caller-supplied tenant
    64	  -- AND an organization the current session has been bound to. This prevents
    65	  -- a session bound to org A from reading org B's IdP policy.
    66	  return query
    67	    select
    68	      t.tenant_id,
    69	      t.provider_type,
    70	      t.enforce_for_non_admins,
    71	      t.jit_provisioning,
    72	      t.mfa_required,
    73	      t.mfa_required_for_roles,
    74	      t.mfa_allowed_methods,
    75	      t.password_complexity,
    76	      t.idle_timeout_min,
    77	      t.session_max_h
    78	    from public.tenant_idp_config t
    79	    where t.tenant_id = p_tenant_id
    80	      and exists (
    81	        select 1
    82	        from public.organizations o
    83	        where o.tenant_id = t.tenant_id
    84	          and o.id = app.current_org_id()
    85	      );
    86	end;
    87	$$;
    88	
    89	-- 3. Lock down the function and grant execute to app_user only.
    90	revoke all on function app.get_my_tenant_idp_config(uuid) from public;
    91	grant execute on function app.get_my_tenant_idp_config(uuid) to app_user;
    92	
    93	-- 4. We deliberately do NOT add a SELECT policy to the table itself —
    94	--    callers must use the function. Anyone trying the old direct path will
    95	--    get 0 rows back (RLS denies, since no policy is defined for app_user).
