   248	    throw new Error(
   249	      `withOrgContext: no public.users row resolves org_id for verified user ${userId}`,
   250	    );
   251	  }
   252	  if (res.rows[0].is_active === false) {
   253	    throw new Error(`withOrgContext: user ${userId} is deactivated`);
   254	  }
   255	
   256	  const homeOrgId = res.rows[0].org_id;
   257	  const requested = await readPlatformOrgOverrideCookie();
   258	  if (!requested.raw) {
   259	    return { userId, orgId: homeOrgId, actAsOrg: false };
   260	  }
   261	  if (!requested.orgId) {
   262	    await logIgnoredPlatformOrgCookie(owner, userId, homeOrgId, requested.raw, 'invalid_cookie');
   263	    return { userId, orgId: homeOrgId, actAsOrg: false };
   264	  }
   265	
   266	  const admin = await owner.query<{ ok: boolean }>(
   267	    `select true as ok
   268	       from app.platform_admins
   269	      where user_id = $1::uuid
   270	        and revoked_at is null
   271	      limit 1`,
   272	    [userId],
   273	  );
   274	  if (admin.rows.length === 0) {
   275	    await logIgnoredPlatformOrgCookie(owner, userId, homeOrgId, requested.orgId, 'not_platform_admin');
   276	    return { userId, orgId: homeOrgId, actAsOrg: false };
   277	  }
   278	
   279	  const target = await owner.query<{ id: string }>(
   280	    `select id::text as id from public.organizations where id = $1::uuid limit 1`,
