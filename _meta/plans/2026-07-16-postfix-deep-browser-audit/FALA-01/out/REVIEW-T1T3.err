   929	    setupCost: number;
   930	    yieldPct?: number;
   931	    roles: Array<{ roleGroup: string; headcount: number; ratePerHour?: number | null }>;
   932	  }>,
   933	): Promise<void> {
   934	  await ctx.client.query(
