   743	/**
   744	 * Legacy gate-only setter (kept for revert-npd-gate / approve-gate which still reason in
   745	 * gate space). It derives a representative stage for the target gate so current_stage
   746	 * never drifts. For G3 (4 stages) it lands on the FIRST G3 stage (packaging); for a
   747	 * downward gate revert this is the safe, earliest stage of that gate.
   748	 */
   749	export function representativeStageForGate(gate: ProjectGate): AnyStage {
   750	  switch (gate) {
   751	    case 'G0':
   752	      return 'brief';
   753	    case 'G1':
   754	      return 'brief';
   755	    case 'G2':
   756	      return 'recipe';
   757	    case 'G3':
   758	      return G3_STAGES[0];
   759	    case 'G4':
   760	      return 'approval';
   761	    case 'Launched':
   762	      return 'launched';
   763	    default:
   764	      return 'brief';
   765	  }
   766	}
