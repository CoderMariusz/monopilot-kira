    45	import pg from 'pg';
    46	import { getOwnerConnection } from '../src/clients.js';
    47	
    48	const VALID_FILENAME = /^(\d{3})-[a-z0-9-]+\.sql$/;
    49	
    50	const packageRoot = resolve(dirname(fileURLToPath(import.meta.url)), '..');
    51	const migrationsDir = resolve(packageRoot, 'migrations');
    52	
    53	const isDryRun = process.argv.includes('--dry-run');
    54	
    55	// Filenames for which a checksum drift is acknowledged via env var.
    56	// Set MIGRATE_ALLOW_CHECKSUM_DRIFT_FOR=017-rbac.sql (comma-separated) to enable.
    57	const allowChecksumDriftFor = new Set<string>(
    58	  (process.env['MIGRATE_ALLOW_CHECKSUM_DRIFT_FOR'] ?? '')
    59	    .split(',')
    60	    .map((s) => s.trim())
    61	    .filter(Boolean),
    62	);
    63	
    64	function sha256(content: string): string {
    65	  return createHash('sha256').update(content, 'utf8').digest('hex');
    66	}
    67	
    68	function numericPrefix(filename: string): number {
    69	  const match = filename.match(/^(\d+)/);
    70	  if (!match) throw new Error(`Cannot extract numeric prefix from: ${filename}`);
    71	  return parseInt(match[1], 10);
    72	}
    73	
    74	async function run(): Promise<void> {
    75	  // 1. Discover and validate migration files
    76	  const allFiles = readdirSync(migrationsDir).filter((f) => f.endsWith('.sql'));
    77	
    78	  const invalid = allFiles.filter((f) => !VALID_FILENAME.test(f));
    79	  if (invalid.length > 0) {
    80	    throw new Error(
    81	      `Migration runner startup error: the following migration files do not match the ` +
    82	        `required NNN-name.sql convention (3-digit numeric prefix, lowercase dash-separated name):\n` +
    83	        invalid.map((f) => `  - ${f}`).join('\n') +
    84	        `\n\nRename these files before running the migration runner.`,
    85	    );
    86	  }
    87	
    88	  // 2. Sort by numeric prefix, then filename for deterministic ordering when prefixes collide.
    89	  const migrationFiles = allFiles.slice().sort((a, b) => {
    90	    const prefixDiff = numericPrefix(a) - numericPrefix(b);
    91	    return prefixDiff !== 0 ? prefixDiff : a.localeCompare(b);
    92	  });
    93	
    94	  // 3. Connect to the database
    95	  const pool: pg.Pool = getOwnerConnection();
