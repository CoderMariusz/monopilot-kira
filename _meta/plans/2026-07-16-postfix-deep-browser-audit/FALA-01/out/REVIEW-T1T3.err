   188	    }
   189	    return { raw: value, orgId: UUID_RE.test(value) ? value : null };
   190	  } catch {
   191	    return { raw: null, orgId: null };
   192	  }
   193	}
   194	
   195	async function logIgnoredPlatformOrgCookie(
   196	  owner: pg.Pool,
