  1043	    // this island without remounting, so a 'submitted'/'error' state from the
  1044	    // previous version would otherwise carry over and make the new version's
  1045	    // button look already-submitted/blocked. Reset it on every real version switch.
  1046	    setSubmitStatus('idle');
