    18	        and ur.org_id = app.current_org_id()
    19	        and r.slug = any($2::text[])
    20	      limit 1`,
    21	    [userId, [...ADMIN_ROLE_SLUGS]],
    22	  );
    23	  if (adminRows.length > 0) return true;
    24	
    25	  const { rows: assignmentRows } = await client.query<{ count: number | string }>(
    26	    `select count(*)::int as count
    27	       from public.user_sites us
    28	      where us.user_id = $1::uuid
    29	        and us.org_id = app.current_org_id()`,
    30	    [userId],
    31	  );
    32	
    33	  return Number(assignmentRows[0]?.count ?? 0) === 0;
    34	}
