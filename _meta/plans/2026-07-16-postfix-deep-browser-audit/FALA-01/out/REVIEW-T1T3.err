   207	    [
   208	      userId,
   209	      homeOrgId,
   210	      reason,
   211	      JSON.stringify({ requested_org_id: requestedOrgId }),
   212	    ],
   213	  );
   214	}
   215	
   216	/**
   217	 * Resolve { userId, orgId } from the Supabase session, MEMOISED PER REQUEST.
   218	 *
   219	 * Wrapped in React `cache()` so the JWT/JWKS verification (`getUser()`) + the
   220	 * `public.users` org lookup run AT MOST ONCE per request, no matter how many
   221	 * `withOrgContext` calls a page/action makes. A project-detail page fans out to
   222	 * ~5-7 withOrgContext calls (layout getProject + canAdvance/canDelete + each
   223	 * stage loader); without this each one re-verified the JWT over the network and
   224	 * re-queried users — the dominant page-load latency + a connection-pool driver.
   225	 * The per-connection session registration + set_org_context still run per call
   226	 * (each app connection needs its own org binding) — only the resolution is shared.
   227	 */
   228	export const resolveContextFromSupabase = cache(async function resolveContextFromSupabase(): Promise<{ userId: string; orgId: string; actAsOrg: boolean }> {
   229	  // getUser() verifies the JWT against Supabase JWKS. NEVER use getSession()
   230	  // for trust decisions — it returns whatever cookies hold without verifying.
   231	  const { data, error } = await getCachedUser();
   232	  if (error || !data?.user?.id) {
   233	    throw new Error(
   234	      `withOrgContext: Supabase JWT verification failed${error ? `: ${error.message}` : ''}`,
   235	    );
   236	  }
   237	
   238	  const userId = data.user.id;
   239	
   240	  // Resolve org_id from public.users (authoritative) — NOT from JWT claims,
   241	  // which can drift after admin moves a user between orgs.
   242	  const owner = getOwnerPool();
   243	  const res = await owner.query<{ org_id: string; is_active: boolean }>(
   244	    `select org_id, is_active from public.users where id = $1::uuid`,
   245	    [userId],
   246	  );
