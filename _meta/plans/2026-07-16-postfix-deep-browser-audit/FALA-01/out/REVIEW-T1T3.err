     1	import { createSupabaseAuthAdmin } from '../../actions/users/supabase-admin';
     2	
     3	/**
     4	 * Copy organizations.onboarding_completed_at into the Supabase JWT app_metadata
     5	 * so edge middleware can admit org members whose org already finished onboarding.
     6	 */
     7	export async function stampOnboardingClaim(userId: string, completedAt: string): Promise<boolean> {
     8	  const supabase = await createSupabaseAuthAdmin();
     9	  const current = await supabase.auth.admin.getUserById(userId);
    10	  if (current.error || !current.data.user) return false;
    11	
    12	  const appMetadata = current.data.user.app_metadata ?? {};
    13	  const updated = await supabase.auth.admin.updateUserById(userId, {
    14	    app_metadata: { ...appMetadata, onboarding_completed_at: completedAt },
    15	  });
    16	  if (updated.error) {
    17	    console.error('[stampOnboardingClaim] Supabase app_metadata update failed', {
    18	      userId,
    19	      message: updated.error.message,
    20	    });
    21	    return false;
    22	  }
    23	  return true;
    24	}
