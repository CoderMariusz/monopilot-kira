     1	-- Migration 005: tenant_idp_config table per PRD §8.x with F-U5 default seed values
     2	-- Scope: control-plane only (tenant-scoped; app_user has no access per 002-rls-baseline pattern)
     3	-- Trigger: AFTER INSERT on tenants auto-seeds one default row per F-U5 / PRD §13
     4	
     5	create table if not exists public.tenant_idp_config (
     6	  tenant_id            uuid         not null primary key references public.tenants(id) on delete cascade,
     7	  provider_type        varchar      not null default 'password',
     8	  idle_timeout_min     int          not null default 60,
     9	  session_max_h        int          not null default 8,
    10	  mfa_required         boolean      not null default true,
    11	  mfa_required_for_roles text[]     not null default array['org.access.admin', 'org.schema.admin'],
    12	  mfa_allowed_methods  text[]       not null default array['totp'],
    13	  password_complexity  varchar      not null default 'strong',
    14	  constraint tenant_idp_config_provider_type_check
    15	    check (provider_type in ('saml', 'oidc', 'password', 'magic'))
    16	);
    17	
    18	-- Seed function: inserts F-U5 default row for each new tenant
    19	create or replace function public.seed_tenant_idp_config()
    20	returns trigger
    21	language plpgsql
    22	security definer
    23	set search_path = pg_catalog
    24	as $$
    25	begin
    26	  insert into public.tenant_idp_config (
    27	    tenant_id,
    28	    provider_type,
    29	    idle_timeout_min,
    30	    session_max_h,
    31	    mfa_required,
    32	    mfa_required_for_roles,
    33	    mfa_allowed_methods,
    34	    password_complexity
    35	  ) values (
    36	    new.id,
    37	    'password',
    38	    60,
    39	    8,
    40	    true,
    41	    array['org.access.admin', 'org.schema.admin'],
    42	    array['totp'],
    43	    'strong'
    44	  )
    45	  on conflict (tenant_id) do nothing;
    46	  return new;
    47	end;
    48	$$;
    49	
    50	-- AFTER INSERT trigger on tenants
    51	drop trigger if exists tenants_seed_idp_config on public.tenants;
    52	create trigger tenants_seed_idp_config
    53	  after insert on public.tenants
    54	  for each row
    55	  execute function public.seed_tenant_idp_config();
    56	
    57	-- RLS: tenant_idp_config is control-plane-only; revoke app_user access (mirrors tenants pattern from 002)
