   514	/**
   515	 * G3 e-signature guard for the G3 → G4 stage crossing (pilot → approval).
   516	 * Mirrors assertG4ESignForHandoff: a valid, immutable G3 e-sign approval (collected
   517	 * by approveProjectGate, gateCode 'G3') must exist before the project may enter G4.
   518	 * Advancing without one throws ESIGN_REQUIRED. (Owner decision F-1, 2026-06-27.)
   519	 */
   520	export async function assertG3ESignForApproval(ctx: OrgContextLike, projectId: string): Promise<void> {
   521	  const { rows } = await ctx.client.query<{ ok: boolean }>(
   522	    `select true as ok
   523	       from public.gate_approvals
   524	      where org_id = app.current_org_id()
   525	        and project_id = $1::uuid
   526	        and gate_code = 'G3'
   527	        and decision = 'approved'
   528	        and esigned_at is not null
   529	        and esign_hash is not null
   530	      limit 1`,
   531	    [projectId],
   532	  );
   533	  if (rows.length === 0) {
   534	    throw new GateActionError('ESIGN_REQUIRED', 403);
   535	  }
   536	}
