    48	type QueryCall = { sql: string; params: unknown[] };
    49	
    50	type FakeClientOptions = {
    51	  hasInvitePermission: boolean;
    52	  seatLimit: number | null;
    53	  activeUsers: number;
    54	  rolesById: Record<string, { id: string; org_id: string; code: string; is_system: boolean; display_order: number | null }>;
    55	  existingUser?: {
    56	    id: string;
    57	    org_id: string;
    58	    email: string;
    59	    name: string;
    60	    role_id: string;
    61	    is_active: boolean;
    62	    invite_token: string | null;
    63	    invite_token_expires_at: string | null;
    64	  } | null;
    65	  siteByName?: Record<string, string>;
    66	};
    67	
    68	type FakeClient = {
    69	  calls: QueryCall[];
    70	  upsertedUser: Record<string, unknown> | null;
    71	  updatedInvite: Record<string, unknown> | null;
    72	  userSiteAssignment: { user_id: string; site_id: string; assigned_by: string } | null;
    73	  outboxEvents: Array<{ event_type: string; payload: Record<string, unknown> }>;
    74	  conflictEmailOrgId?: string;
    75	  query: (sql: string, params?: unknown[]) => Promise<{ rows: unknown[]; rowCount: number }>;
    76	};
    77	
    78	function makeClient(opts: FakeClientOptions): FakeClient {
    79	  const calls: QueryCall[] = [];
    80	  const client: FakeClient = {
    81	    calls,
    82	    upsertedUser: null,
    83	    updatedInvite: null,
    84	    userSiteAssignment: null,
    85	    outboxEvents: [],
    86	    async query(sql: string, params: unknown[] = []) {
    87	      calls.push({ sql, params });
    88	      const norm = sql.replace(/\s+/g, ' ').trim().toLowerCase();
    89	
    90	      if (norm.includes('from public.sites s') && norm.includes('app.current_org_id()')) {
    91	        const siteName = String(params[2] ?? '');
    92	        const siteId = opts.siteByName?.[siteName];
    93	        return { rows: siteId ? [{ id: siteId }] : [], rowCount: siteId ? 1 : 0 };
    94	      }
    95	
    96	      if (norm.includes('insert into public.user_sites')) {
    97	        client.userSiteAssignment = {
    98	          user_id: String(params[0]),
    99	          site_id: String(params[1]),
   100	          assigned_by: String(params[2]),
   101	        };
   102	        return { rows: [{ site_id: params[1] }], rowCount: 1 };
   103	      }
   104	
   105	      if (norm.startsWith('select') && norm.includes('role_permissions') && norm.includes('user_roles')) {
   106	        return {
   107	          rows: opts.hasInvitePermission ? [{ ok: true }] : [],
   108	          rowCount: opts.hasInvitePermission ? 1 : 0,
   109	        };
   110	      }
   111	
   112	      if (norm.startsWith('select seat_limit')) {
   113	        return { rows: [{ seat_limit: opts.seatLimit }], rowCount: 1 };
   114	      }
   115	
   116	      if (norm.includes('count(*)') && norm.includes('users')) {
   117	        return { rows: [{ active_user_count: opts.activeUsers }], rowCount: 1 };
   118	      }
   119	
   120	      if (norm.startsWith('select') && norm.includes('from public.roles') && norm.includes('where id =')) {
   121	        const id = params[0] as string;
   122	        const role = opts.rolesById[id];
   123	        return { rows: role ? [role] : [], rowCount: role ? 1 : 0 };
   124	      }
   125	
   126	      if (norm.startsWith('select') && norm.includes('from public.users') && norm.includes('where email =')) {
   127	        if (!opts.existingUser) {
   128	          return { rows: [], rowCount: 0 };
   129	        }
   130	        return { rows: [opts.existingUser], rowCount: 1 };
   131	      }
   132	
   133	      if (norm.startsWith('update public.users') && norm.includes('invite_token =')) {
   134	        client.updatedInvite = {
   135	          invite_token: params[0],
   136	          invite_token_expires_at: params[1],
   137	          id: params[2],
   138	          org_id: params[3],
   139	        };
   140	        return { rows: [{ id: params[2] }], rowCount: 1 };
   141	      }
   142	
   143	      if (norm.startsWith('insert into public.users')) {
   144	        if (client.conflictEmailOrgId && client.conflictEmailOrgId !== params[0]) {
   145	          return { rows: [], rowCount: 0 };
   146	        }
   147	        client.upsertedUser = {
   148	          org_id: params[0],
   149	          email: params[1],
   150	          name: params[2],
   151	          role_id: params[3],
   152	          language: params[4],
   153	          invite_token: params[5],
   154	          invite_token_expires_at: params[6],
   155	        };
   156	        return { rows: [{ id: 'new-invite-user-id' }], rowCount: 1 };
   157	      }
   158	
   159	      if (norm.startsWith('insert into public.outbox_events')) {
   160	        client.outboxEvents.push({
   161	          event_type: params[1] as string,
   162	          payload: JSON.parse(params[3] as string),
   163	        });
   164	        return { rows: [], rowCount: 1 };
   165	      }
   166	
   167	      return { rows: [], rowCount: 0 };
   168	    },
   169	  };
   170	  return client;
   171	}
