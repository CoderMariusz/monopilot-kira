     7	
     8	function toIsoString(value: string | Date | null | undefined): string | null {
     9	  if (value == null) return null;
    10	  if (value instanceof Date) return Number.isNaN(value.getTime()) ? null : value.toISOString();
    11	  if (typeof value === 'string' && value.trim().length > 0) return value;
    12	  return null;
