   323	
   324	export async function withOrgContext<T>(
   325	  action: (ctx: OrgContext) => Promise<T>,
   326	): Promise<T> {
   327	  const { userId, orgId, actAsOrg } = isTestEnvWithStub()
   328	    ? { ...(await resolveContextFromTestStub()), actAsOrg: false }
   329	    : await resolveContextFromSupabase().catch((err) => annotateOrgContextError('resolve_context', err));
   330	
   331	  // Fresh session_token per call — guarantees no collision in
   332	  // app.active_org_contexts across concurrent requests on the same backend PID
   333	  // and avoids re-using a stale token registered by a previous call.
   334	  const sessionToken = randomUUID();
   335	
   336	  const owner = getOwnerPool();
   337	  await owner
   338	    .query(
   339	      // mig 382: register the authenticated user_id on the OWNER pool (app_user
   340	      // cannot write this table), so app.set_org_context can copy it into the
   341	      // active context and app.current_user_id() returns an unspoofable user for
   342	      // the per-user-site RLS policies. set_org_context stays 2-arg (it reads the
   343	      // user_id from this trusted row, never from a caller-supplied param).
   344	      `insert into app.session_org_contexts (session_token, org_id, user_id) values ($1::uuid, $2::uuid, $3::uuid)`,
   345	      [sessionToken, orgId, userId],
   346	    )
   347	    .catch((err) => annotateOrgContextError('owner_register_session', err));
   348	
   349	  const app = getAppPool();
   350	  const client = await app.connect().catch((err) => annotateOrgContextError('app_pool_connect', err));
   351	  try {
   352	    await client.query('begin').catch((err) => annotateOrgContextError('begin', err));
   353	    await client
   354	      .query(`select app.set_org_context($1::uuid, $2::uuid)`, [sessionToken, orgId])
   355	      .catch((err) => annotateOrgContextError('set_org_context', err));
   356	    const result = await action({ userId, orgId, sessionToken, client, actAsOrg });
   357	    await client.query('commit');
   358	    return result;
   359	  } catch (err) {
   360	    try {
   361	      await client.query('rollback');
   362	    } catch {
   363	      /* noop — connection may already be in a bad state */
   364	    }
   365	    throw err;
   366	  } finally {
   367	    client.release();
   368	    // Best-effort cleanup so app.session_org_contexts doesn't accumulate.
   369	    // If this delete fails (network blip, owner-pool exhaustion, process
   370	    // crash) the row is leaked. GC for those orphans is handled by
   371	    // `app.gc_session_org_contexts(p_max_age_seconds)` — see migration
   372	    // packages/db/migrations/031-session-org-contexts-janitor.sql. The
   373	    // operator wires that function to a 5-minute cron with a default
   374	    // 10-minute TTL so leaks are cleaned up out-of-band.
   375	    try {
   376	      await owner.query(
   377	        `delete from app.session_org_contexts where session_token = $1::uuid`,
   378	        [sessionToken],
   379	      );
   380	    } catch {
   381	      /* noop */
   382	    }
   383	  }
   384	}
