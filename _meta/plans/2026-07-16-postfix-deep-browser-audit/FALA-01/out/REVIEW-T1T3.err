    42	
    43	  const { rows } = await client.query<{ ok: boolean }>(
    44	    `select true as ok
    45	       from public.user_sites us
    46	      where us.user_id = $1::uuid
    47	        and us.site_id = $2::uuid
    48	        and us.org_id = app.current_org_id()
    49	      limit 1`,
    50	    [userId, siteId],
    51	  );
    52	
    53	  if (rows.length > 0) return true;
    54	  throw new SiteAccessError(siteId);
    55	}

