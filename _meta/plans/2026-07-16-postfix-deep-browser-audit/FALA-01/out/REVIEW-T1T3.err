   285	       from public.sites s
   286	      where s.org_id = app.current_org_id()
   287	        and s.is_active = true
   288	        and (
   289	          ($1::boolean and s.id = $2::uuid)
   290	          or lower(trim(s.name)) = lower(trim($3::text))
   291	          or lower(trim(s.site_code)) = lower(trim($3::text))
   292	        )
   293	      limit 2`,
   294	    [siteLooksLikeUuid, site, site],
   295	  );
   296	
   297	  if (rows.length !== 1) {
   298	    return { error: 'invalid_input' };
   299	  }
   300	
   301	  return { siteId: rows[0]?.id ?? null };
   302	}
