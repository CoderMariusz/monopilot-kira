   552	/**
   553	 * Hard blockers that must be resolved before advancing the project's CURRENT stage.
   554	 * Required gate-checklist items and required stage fields are enforced by
   555	 * evaluateStageGate (non-overridable); this helper covers operational guards only.
   556	 */
   557	export async function getBlockers(
   558	  ctx: OrgContextLike,
   559	  project: GateProjectRow,
   560	  targetStage: AnyStage,
   561	): Promise<GateBlocker[]> {
   562	  const blockers: GateBlocker[] = [];
   563	
   564	  // Recipe guard: leaving the `recipe` stage requires the formulation's current
   565	  // version to have at least one ingredient. This is the ONLY real completeness
   566	  // signal for the recipe stage — the seeded G2 checklist (shelf-life / label / HACCP
   567	  // / business case) belongs to later stages and is advisory only.
   568	  if (project.current_stage === 'recipe') {
   569	    const count = await countCurrentVersionIngredients(ctx.client, project.id);
   570	    if (count === 0) {
   571	      blockers.push({
   572	        code: 'RECIPE_INGREDIENTS_REQUIRED',
   573	        message: 'Add at least one ingredient to the recipe before advancing.',
   574	      });
   575	    }
   576	  }
   577	
   578	  // FG conflict guard: only relevant when about to create the FG candidate (entering
   579	  // the `packaging` stage) and the project has no FG mapped yet.
   580	  if (targetStage === FG_CANDIDATE_STAGE && !project.product_code) {
   581	    const conflict = await findFgConflict(ctx.client, project.id, normalizeProductCode(null, project));
   582	    if (conflict) {
   583	      blockers.push({
   584	        code: 'FG_ALREADY_LINKED',
   585	        message: `Finished Good ${conflict.product_code} is already linked to another active NPD project.`,
   586	      });
   587	    }
   588	  }
   589	
   590	  if (project.current_stage === 'handoff' && targetStage === 'launched') {
   591	    blockers.push(...await getLaunchComplianceBlockers(ctx, project));
   592	  }
   593	
   594	  return blockers;
   595	}
   596	
   597	/**
   598	 * Regulatory launch guard (handoff → launched): reuses evaluateApprovalCriteria so
   599	 * C1/C5/C7 and every other required criterion must be satisfied (pass/warn/not_required).
   600	 * Pending criteria block launch; warns (expiring docs, low margin, etc.) do not.
   601	 */
   602	export async function getLaunchComplianceBlockers(
   603	  ctx: OrgContextLike,
   604	  project: GateProjectRow,
   605	): Promise<GateBlocker[]> {
   606	  const productCode = project.product_code?.trim();
   607	  if (!productCode) {
   608	    return [{
   609	      code: 'LAUNCH_COMPLIANCE_BLOCKED',
   610	      message: 'Map a finished-good product before launch.',
   611	      gateCode: 'G4',
   612	    }];
   613	  }
   614	
   615	  const evaluation = await evaluateApprovalCriteriaWithClient(ctx.client, productCode);
   616	  if (!evaluation.ok) {
   617	    return [{
   618	      code: 'LAUNCH_COMPLIANCE_BLOCKED',
   619	      message: 'Approval criteria could not be evaluated for this product.',
   620	      gateCode: 'G4',
   621	    }];
   622	  }
   623	
   624	  const blockingKeys = new Set<keyof ApprovalCriteriaResult>(launchBlockingCriteria(evaluation.data));
   625	
   626	  // Launch is a regulatory dispatch gate: it requires at least one VALID (non-deleted,
   627	  // non-expired) compliance document REGARDLESS of the Approval-stage C7 config. An org
   628	  // that marks C7 not-required in npd_approval_criterion_config (so C7 -> 'not_required'
   629	  // for the Approval screen) must still not be able to launch a product with no docs.
   630	  const docs = await ctx.client.query<{ valid_docs: number }>(
   631	    `select count(*)::int as valid_docs
   632	       from public.compliance_docs
   633	      where product_code = $1
   634	        and org_id = app.current_org_id()
   635	        and deleted_at is null
   636	        and coalesce(expiry_state, 'Valid') = 'Valid'
   637	        and (expires_at is null or expires_at >= current_date)`,
   638	    [productCode],
   639	  );
   640	  if ((docs.rows[0]?.valid_docs ?? 0) <= 0) blockingKeys.add('C7');
   641	
   642	  if (blockingKeys.size === 0) return [];
   643	
   644	  const keys = [...blockingKeys];
   645	  const detail = keys.map((key) => LAUNCH_CRITERION_LABELS[key]).join(', ');
   646	  return [{
   647	    code: 'LAUNCH_COMPLIANCE_BLOCKED',
   648	    message: `Launch blocked — complete approval criteria: ${detail}.`,
   649	    pendingCriteria: keys.join(','),
   650	    gateCode: 'G4',
   651	  }];
   652	}
