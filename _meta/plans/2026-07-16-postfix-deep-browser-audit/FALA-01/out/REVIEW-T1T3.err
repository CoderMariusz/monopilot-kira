   538	export async function loadProjectForUpdate(ctx: OrgContextLike, projectId: string): Promise<GateProjectRow> {
   539	  const { rows } = await ctx.client.query<GateProjectRow>(
   540	    `select id, code, name, type, current_gate, current_stage, product_code
