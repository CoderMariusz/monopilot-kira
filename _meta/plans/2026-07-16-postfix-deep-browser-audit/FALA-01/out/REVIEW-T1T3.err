     1	'use server';
     2	
     3	import { withOrgContext } from '../../lib/auth/with-org-context';
     4	import { SYSTEM_ROLE_CODES_FORBIDDEN_AS_DEFAULT } from './user-role-policy';
     5	import { createSupabaseAuthAdmin } from './supabase-admin';
     6	
     7	const INVITE_TTL_SECONDS = 604800;
     8	const INVITE_PERMISSION = 'settings.users.invite';
     9	
    10	export type InviteUserInput = {
    11	  email: string;
    12	  name?: string;
    13	  roleId?: string;
    14	  site?: string;
    15	  personalMessage?: string;
    16	  language?: string;
    17	  redirectTo?: string;
    18	};
    19	
    20	export type InviteUserResult =
    21	  | { ok: true; data: { email: string; expiresAt: string; resent?: boolean } }
    22	  | {
    23	      ok: false;
    24	      error:
    25	        | 'invalid_input'
    26	        | 'forbidden'
    27	        | 'seat_limit_exceeded'
    28	        | 'email_taken'
    29	        | 'invite_failed'
    30	        | 'persistence_failed';
    31	    };
    32	
    33	type OrganizationSeatRow = {
    34	  seat_limit: number | null;
    35	};
    36	
    37	type RoleRow = {
    38	  id: string;
    39	  org_id: string;
    40	  code: string;
    41	  is_system: boolean;
    42	  display_order: number | null;
    43	};
    44	
    45	type ExistingUserRow = {
    46	  id: string;
    47	  is_active: boolean;
    48	  invite_token: string | null;
    49	  invite_token_expires_at: string | null;
    50	};
    51	
    52	function hasOutstandingInvite(row: ExistingUserRow): boolean {
    53	  return row.invite_token !== null || row.invite_token_expires_at !== null;
    54	}
    55	
    56	function normalizeEmail(value: unknown): string | null {
    57	  if (typeof value !== 'string') return null;
    58	  const email = value.trim().toLowerCase();
    59	  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ? email : null;
    60	}
    61	
    62	function normalizeString(value: unknown): string | null {
    63	  if (typeof value !== 'string') return null;
    64	  const trimmed = value.trim();
    65	  return trimmed.length > 0 ? trimmed : null;
    66	}
    67	
    68	export async function inviteUser(input: InviteUserInput): Promise<InviteUserResult> {
    69	  const email = normalizeEmail(input?.email);
    70	  if (!email) {
    71	    return { ok: false, error: 'invalid_input' };
    72	  }
    73	
    74	  const requestedRoleId = normalizeString(input.roleId);
    75	  if (!requestedRoleId) {
    76	    return { ok: false, error: 'invalid_input' };
    77	  }
    78	
    79	  const name = normalizeString(input.name) ?? email;
    80	  const site = normalizeString(input.site);
    81	  const personalMessage = normalizeString(input.personalMessage);
    82	  const language = normalizeString(input.language) ?? 'pl';
    83	  const redirectTo = normalizeRedirectTo(input.redirectTo);
    84	  if (redirectTo === 'invalid') {
    85	    return { ok: false, error: 'invalid_input' };
    86	  }
    87	  const expiresAt = new Date(Date.now() + INVITE_TTL_SECONDS * 1000);
    88	
    89	  return withOrgContext(async ({ userId, orgId, client }) => {
    90	    // Fail-closed permission-based RBAC: require an explicit grant of
    91	    // settings.users.invite on one of the caller's roles. Role-code fallbacks
    92	    // are honored only when the role exposes the permission via its slug/code
    93	    // or jsonb permissions array — never via hard-coded role-slug allowlists,
    94	    // which drift from the permission registry.
    95	    const { rows: permRows } = await client.query<{ ok: boolean }>(
    96	      `select true as ok
    97	         from public.user_roles ur
    98	         join public.roles r on r.id = ur.role_id and r.org_id = ur.org_id
    99	         left join public.role_permissions rp on rp.role_id = r.id and rp.permission = $3
   100	        where ur.user_id = $1::uuid
   101	          and ur.org_id = $2::uuid
   102	          and (
   103	            rp.permission is not null
   104	            or r.code = $3
   105	            or r.slug = $3
   106	            or coalesce(r.permissions, '[]'::jsonb) ? $3
   107	          )
   108	        limit 1`,
   109	      [userId, orgId, INVITE_PERMISSION],
   110	    );
   111	    if (permRows.length === 0) {
   112	      return { ok: false, error: 'forbidden' };
   113	    }
   114	
   115	    const { rows: roleRows } = await client.query<RoleRow>(
   116	      `select id, org_id, code, is_system, display_order
   117	         from public.roles
   118	        where id = $1::uuid`,
   119	      [requestedRoleId],
   120	    );
   121	    const role = roleRows[0];
   122	    if (!role || role.org_id !== orgId) {
   123	      return { ok: false, error: 'invalid_input' };
   124	    }
   125	    if (SYSTEM_ROLE_CODES_FORBIDDEN_AS_DEFAULT.has(role.code)) {
   126	      return { ok: false, error: 'invalid_input' };
   127	    }
   128	    const roleId = role.id;
   129	
   130	    const resolvedSite = await resolveInviteSiteId(client, site);
   131	    if ('error' in resolvedSite) {
   132	      return { ok: false, error: resolvedSite.error };
   133	    }
   134	    const inviteSiteId = resolvedSite.siteId;
   135	
   136	    const { rows: seatRows } = await client.query<OrganizationSeatRow>(
   137	      `select seat_limit from public.organizations where id = $1::uuid`,
   138	      [orgId],
   139	    );
   140	    const seatLimit = seatRows[0]?.seat_limit ?? null;
   141	
   142	    const { rows: countRows } = await client.query<{ active_user_count: string | number }>(
   143	      `select count(*) as active_user_count
   144	         from public.users
   145	        where org_id = $1::uuid
   146	          and is_active = true`,
   147	      [orgId],
   148	    );
   149	    const activeUserCount = Number(countRows[0]?.active_user_count ?? 0);
   150	    if (seatLimit !== null && activeUserCount >= seatLimit) {
   151	      return { ok: false, error: 'seat_limit_exceeded' };
   152	    }
   153	
   154	    const { rows: existingRows } = await client.query<ExistingUserRow & { org_id: string; role_id: string }>(
   155	      `select id, org_id, is_active, invite_token, invite_token_expires_at, role_id
   156	         from public.users
   157	        where email = $1::citext
   158	        limit 1`,
   159	      [email],
   160	    );
   161	    const existing = existingRows[0];
   162	
   163	    if (existing && existing.org_id !== orgId) {
   164	      return { ok: false, error: 'invalid_input' };
   165	    }
   166	
   167	    if (existing?.is_active) {
   168	      return { ok: false, error: 'email_taken' };
   169	    }
   170	
   171	    const minted = await mintInviteLink(email, orgId, userId, site, personalMessage, redirectTo);
   172	    if (!minted.ok) {
   173	      return minted;
   174	    }
   175	    const inviteToken = minted.inviteToken;
   176	
   177	    try {
   178	      if (existing) {
   179	        if (!hasOutstandingInvite(existing)) {
   180	          return { ok: false, error: 'email_taken' };
   181	        }
   182	
   183	        const resent = await client.query<{ id: string }>(
   184	          `update public.users
   185	              set invite_token = $1,
   186	                  invite_token_expires_at = $2::timestamptz,
   187	                  updated_at = now()
   188	            where id = $3::uuid
   189	              and org_id = $4::uuid
   190	              and is_active = false
   191	            returning id`,
   192	          [inviteToken, expiresAt.toISOString(), existing.id, orgId],
   193	        );
   194	        if ((resent.rowCount ?? resent.rows.length) < 1) {
   195	          return { ok: false, error: 'persistence_failed' };
   196	        }
   197	
   198	        if (inviteSiteId) {
   199	          const scoped = await replaceInvitedUserSiteScope(client, existing.id, inviteSiteId, userId);
   200	          if (!scoped) {
   201	            throw new Error('INVITE_SITE_SCOPE_FAILED');
   202	          }
   203	        }
   204	
   205	        await writeInviteAuditAndOutbox(
   206	          client,
   207	          orgId,
