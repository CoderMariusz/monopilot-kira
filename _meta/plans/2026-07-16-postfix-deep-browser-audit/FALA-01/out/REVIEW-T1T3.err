   673	           on fv.formulation_id = f.id
   674	          and fv.state = 'locked'
   675	        where f.project_id = $1::uuid
   710	            and (
   711	              lr.locked_version_id is null
   712	              or nsr.formulation_version_id = lr.locked_version_id
   713	            )
