     1	/**
     2	 * WIP definition composition cycle guard (PF-R05-01 / V-TEC-13 analogue).
     3	 *
     4	 * Pure graph helpers + org-scoped edge loader. Reuses the BOM cycle-detection
     5	 * adjacency/DFS primitives so self-reference and multi-node WIP→WIP loops are
     6	 * rejected with one shared implementation.
     7	 */
     8	
     9	import { buildGraph, detectCycle } from '../../bom/_actions/cycle-detection';
    10	
    11	export type WipCompositionEdge = { parent: string; component: string };
    12	
    13	type QueryClient = {
    14	  query<T = Record<string, unknown>>(sql: string, params?: readonly unknown[]): Promise<{ rows: T[] }>;
    15	};
    16	
    17	/** Returns true when `parentItemId` → proposed ingredients would close a loop. */
    18	export function detectWipDefinitionCompositionCycle(
    19	  existingEdges: ReadonlyArray<WipCompositionEdge>,
    20	  parentItemId: string,
    21	  proposedComponentItemIds: ReadonlyArray<string>,
    22	): boolean {
    23	  const graph = buildGraph(existingEdges);
    24	  return detectCycle(graph, parentItemId, proposedComponentItemIds);
    25	}
    26	
    27	/**
    28	 * Active/draft definition ingredient edges, excluding the row being rewritten
    29	 * (its proposed ingredients replace the persisted set).
    30	 */
    31	export async function loadWipCompositionEdges(
    32	  client: QueryClient,
    33	  excludeParentItemId: string | null,
    34	): Promise<WipCompositionEdge[]> {
    35	  const { rows } = await client.query<{ parent: string; component: string }>(
    36	    `select wd.item_id::text as parent,
    37	            wdi.item_id::text as component
    38	       from public.wip_definitions wd
    39	       join public.wip_definition_ingredients wdi
    40	         on wdi.org_id = wd.org_id
    41	        and wdi.wip_definition_id = wd.id
    42	      where wd.org_id = app.current_org_id()
    43	        and wd.item_id is not null
    44	        and wd.status in ('active', 'draft')
    45	        and ($1::uuid is null or wd.item_id <> $1::uuid)`,
    46	    [excludeParentItemId],
    47	  );
    48	  return rows;
    49	}
    50	
    51	export async function assertWipDefinitionCompositionAcyclic(
    52	  client: QueryClient,
    53	  parentItemId: string,
    54	  proposedComponentItemIds: string[],
    55	): Promise<{ ok: true } | { ok: false; code: 'WIP_DEFINITION_CYCLE' }> {
    56	  const edges = await loadWipCompositionEdges(client, parentItemId);
    57	  if (detectWipDefinitionCompositionCycle(edges, parentItemId, proposedComponentItemIds)) {
    58	    return { ok: false, code: 'WIP_DEFINITION_CYCLE' };
    59	  }
    60	  return { ok: true };
    61	}
