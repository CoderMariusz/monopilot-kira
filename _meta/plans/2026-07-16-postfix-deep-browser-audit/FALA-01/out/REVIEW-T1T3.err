     1	-- 510 — tenant_idp_config upsert writer + legacy backfill (PF-R01-02 / C003 regression)
     2	--
     3	-- Migration 509's app.upsert_my_tenant_idp_policy only UPDATEd an existing row and
     4	-- returned false when tenant_idp_config was missing (legacy tenants). Security settings
     5	-- save then surfaced persistence_failed. Backfill missing rows and make the writer
     6	-- INSERT … ON CONFLICT so saves succeed for every org with a tenant_id.
     7	
     8	insert into public.tenant_idp_config (
     9	  tenant_id,
    10	  provider_type,
    11	  idle_timeout_min,
    12	  session_max_h,
    13	  mfa_required,
    14	  mfa_required_for_roles,
    15	  mfa_allowed_methods,
    16	  password_complexity
    17	)
    18	select t.id,
    19	       'password',
    20	       60,
    21	       8,
    22	       true,
    23	       array['org.access.admin', 'org.schema.admin']::text[],
    24	       array['totp']::text[],
    25	       'strong'
    26	  from public.tenants t
    27	  left join public.tenant_idp_config c on c.tenant_id = t.id
    28	 where c.tenant_id is null
    29	on conflict (tenant_id) do nothing;
    30	
    31	create or replace function app.upsert_my_tenant_idp_policy(
    32	  p_mfa_required boolean,
    33	  p_mfa_required_for_roles text[],
    34	  p_mfa_allowed_methods text[],
    35	  p_enforce_for_non_admins boolean default null
    36	)
    37	returns boolean
    38	language plpgsql
    39	security definer
    40	set search_path = pg_catalog
    41	as $$
    42	declare
    43	  v_tenant_id uuid;
    44	begin
    45	  select o.tenant_id
    46	    into v_tenant_id
    47	    from public.organizations o
    48	   where o.id = app.current_org_id();
    49	
    50	  if v_tenant_id is null then
    51	    return false;
    52	  end if;
    53	
    54	  insert into public.tenant_idp_config (
    55	    tenant_id,
    56	    provider_type,
    57	    idle_timeout_min,
    58	    session_max_h,
    59	    mfa_required,
    60	    mfa_required_for_roles,
    61	    mfa_allowed_methods,
    62	    password_complexity,
    63	    enforce_for_non_admins
    64	  ) values (
    65	    v_tenant_id,
    66	    'password',
    67	    60,
    68	    8,
    69	    p_mfa_required,
    70	    coalesce(p_mfa_required_for_roles, '{}'::text[]),
    71	    coalesce(p_mfa_allowed_methods, array['totp']::text[]),
    72	    'strong',
    73	    coalesce(p_enforce_for_non_admins, false)
    74	  )
    75	  on conflict (tenant_id) do update
    76	     set mfa_required = excluded.mfa_required,
    77	         mfa_required_for_roles = excluded.mfa_required_for_roles,
    78	         mfa_allowed_methods = excluded.mfa_allowed_methods,
    79	         enforce_for_non_admins = coalesce(
    80	           p_enforce_for_non_admins,
    81	           public.tenant_idp_config.enforce_for_non_admins
    82	         ),
    83	         updated_at = pg_catalog.now();
    84	
    85	  return true;
    86	end;
    87	$$;
    88	
    89	revoke all on function app.upsert_my_tenant_idp_policy(boolean, text[], text[], boolean) from public;
    90	grant execute on function app.upsert_my_tenant_idp_policy(boolean, text[], text[], boolean) to app_user;
    91	
    92	comment on function app.upsert_my_tenant_idp_policy(boolean, text[], text[], boolean) is
    93	  'PF-R01-02: persist org-scoped IdP policy fields (MFA + optional SSO enforcement) for the current org tenant; inserts missing legacy rows.';
