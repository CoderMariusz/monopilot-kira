    35	  add column if not exists updated_at timestamptz not null default now();
    36	
    37	-- updated_at trigger function (SECURITY DEFINER, restricted search_path)
    38	create or replace function public.touch_updated_at()
    39	returns trigger
    40	language plpgsql
    41	security definer
    42	set search_path = pg_catalog
    43	as $$
    44	begin
    45	  new.updated_at := pg_catalog.now();
    46	  return new;
    47	end;
    48	$$;
    49	
    50	-- BEFORE UPDATE trigger on tenant_idp_config
    51	drop trigger if exists tenant_idp_config_touch_updated_at on public.tenant_idp_config;
