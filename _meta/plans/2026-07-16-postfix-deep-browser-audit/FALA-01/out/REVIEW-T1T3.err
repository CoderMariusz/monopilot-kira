    12	export async function isUserSiteAccessUnrestricted(userId: string, client: SiteAccessClient): Promise<boolean> {
    13	  const { rows: adminRows } = await client.query<{ ok: number }>(
    14	    `select 1 as ok
    15	       from public.user_roles ur
    16	       join public.roles r on r.id = ur.role_id and r.org_id = ur.org_id
