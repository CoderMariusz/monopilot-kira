    88	export async function assignUserSites(input: AssignUserSitesInput): Promise<AssignUserSitesResult> {
    89	  const targetUserId = normalizeId(input?.userId);
    90	  const siteIds = normalizeSiteIds(input?.siteIds);
    91	  if (!targetUserId || siteIds === null) {
    92	    return { ok: false, error: 'invalid_input' };
    93	  }
    94	
    95	  return withOrgContext(async ({ userId, orgId, client }) => {
    96	    try {
    97	      await requirePermission(client as QueryClient, userId, orgId, ASSIGN_PERMISSION);
    98	
    99	      // Validate the target user is in the caller's org and (if any) every
   100	      // requested site is an active org site. A single guard query returns the
   101	      // existence flags so we never half-apply a bad payload.
   102	      const { rows: guardRows } = await (client as QueryClient).query<{
   103	        target_user_found: boolean;
   104	        all_sites_valid: boolean;
   105	      }>(
   106	        `select
   107	            exists(
   108	              select 1 from public.users u
   109	               where u.id = $1::uuid and u.org_id = app.current_org_id()
   110	            ) as target_user_found,
   111	            (
   112	              select count(*) = coalesce(array_length($2::uuid[], 1), 0)
   113	                from public.sites s
   114	               where s.id = any($2::uuid[])
   115	                 and s.org_id = app.current_org_id()
   116	                 and s.is_active = true
   117	            ) as all_sites_valid`,
   118	        [targetUserId, siteIds],
   119	      );
   120	      const guard = guardRows[0];
   121	      if (!guard?.target_user_found) {
   122	        return { ok: false, error: 'not_found' };
   123	      }
   124	      if (!guard.all_sites_valid) {
   125	        return { ok: false, error: 'invalid_input' };
   126	      }
   127	
   128	      if (siteIds.length === 0 && !(await hasAllSiteAuthority(client as QueryClient, targetUserId, orgId))) {
   129	        return { ok: false, error: 'empty_site_assignment_forbidden' };
   130	      }
   131	
   132	      // Replace transactionally: the submitted set is authoritative. The
   133	      // delete clears prior assignments (org-scoped via app.current_org_id());
   134	      // the insert (unnest) writes one row per site with the actor as
   135	      // assigned_by. Empty siteIds is only reached for all-site authority roles.
   136	      const { rows: replacedRows } = await (client as QueryClient).query<{ replaced: string | null }>(
   137	        `with deleted as (
   138	            delete from public.user_sites
   139	             where user_id = $1::uuid
   140	               and org_id = app.current_org_id()
   141	            returning site_id
   142	          ),
   143	          inserted as (
   144	            insert into public.user_sites (user_id, site_id, org_id, assigned_by)
   145	            select $1::uuid, s.site_id, app.current_org_id(), $3::uuid
   146	              from unnest($2::uuid[]) as s(site_id)
   147	            returning site_id
   148	          )
   149	          select (select count(*)::text from inserted) as replaced`,
   150	        [targetUserId, siteIds, userId],
   151	      );
   152	      if (!replacedRows[0]) {
   153	        return { ok: false, error: 'persistence_failed' };
   154	      }
   155	
   156	      await (client as QueryClient).query(
   157	        `insert into public.audit_log
   158	           (org_id, actor_user_id, actor_type, action, resource_type, resource_id, before_state, after_state, retention_class)
   159	         values ($1::uuid, $2::uuid, 'user', $3, 'users', $4, null, $5::jsonb, 'security')`,
   160	        [
   161	          orgId,
   162	          userId,
   163	          'settings.user.sites_assigned',
   164	          targetUserId,
   165	          JSON.stringify({ org_id: orgId, target_user_id: targetUserId, site_ids: siteIds, actor_user_id: userId }),
   166	        ],
   167	      );
   168	
   169	      // NOTE: no outbox_events emit — 'settings.user.sites_assigned' is not in the
   170	      // outbox_events_event_type_check CHECK (verified live: 23514), and no consumer
   171	      // needs it. The audit_log entry above is the authoritative record. If a
   172	      // downstream consumer is ever needed, add the event via a dedicated CHECK
   173	      // migration (the ~180-value list must be reproduced carefully).
   174	      try {
   175	        revalidateLocalized('/settings/users');
     1	/**
     2	 * Shared server-side role-grant guards for user provisioning and assignment.
     3	 * NOT a 'use server' module — imported by server actions only.
     4	 */
     5	import { SYSTEM_ROLE_CODES_FORBIDDEN_AS_DEFAULT } from './user-role-policy';
     6	
     7	/** Super roles bypass grant-subset checks (mirrors create-user-with-password). */
     8	export const SUPER_ROLE_CODES = ['owner', 'admin', 'org_admin'] as const;
     9	
    10	/** May assign privileged system roles (owner/admin/org.access.admin family). */
    11	export const PRIVILEGED_ROLE_ASSIGNER_CODES = ['owner', 'admin', 'org_admin', 'org.access.admin'] as const;
    12	
    13	/**
    14	 * Role slugs that legitimately have zero site assignments (all-site unrestricted).
    15	 * Byte-for-byte equivalent to mig 383 app.user_can_see_site condition (2) — slug only.
    16	 */
    17	export const ALL_SITE_AUTHORITY_ROLE_SLUGS = [
    18	  'org.access.admin',
    19	  'org.platform.admin',
    20	  'owner',
    21	  'admin',
    22	  'org_admin',
    23	] as const;
    24	
    25	export type RoleGrantQueryClient = {
    26	  query<T = Record<string, unknown>>(
    27	    sql: string,
    28	    params?: readonly unknown[],
    29	  ): Promise<{ rows: T[]; rowCount?: number | null }>;
    30	};
    31	
    32	export async function hasRoleFromCodes(
    33	  client: RoleGrantQueryClient,
    34	  userId: string,
    35	  orgId: string,
    36	  codes: readonly string[],
    37	): Promise<boolean> {
    38	  const { rows } = await client.query<{ ok: boolean }>(
    39	    `select true as ok
    40	       from public.user_roles ur
    41	       join public.roles r on r.id = ur.role_id and r.org_id = ur.org_id
    42	      where ur.user_id = $1::uuid
    43	        and ur.org_id = $2::uuid
    44	        and (r.code = any($3::text[]) or r.slug = any($3::text[]))
    45	      limit 1`,
    46	    [userId, orgId, codes],
    47	  );
    48	  return rows[0]?.ok === true;
    49	}
    50	
    51	export async function hasSuperRole(
    52	  client: RoleGrantQueryClient,
    53	  userId: string,
    54	  orgId: string,
    55	): Promise<boolean> {
    56	  return hasRoleFromCodes(client, userId, orgId, SUPER_ROLE_CODES);
    57	}
    58	
    59	export async function canAssignPrivilegedRoles(
    60	  client: RoleGrantQueryClient,
    61	  userId: string,
    62	  orgId: string,
    63	): Promise<boolean> {
    64	  return hasRoleFromCodes(client, userId, orgId, PRIVILEGED_ROLE_ASSIGNER_CODES);
    65	}
    66	
    67	export async function hasAllSiteAuthority(
    68	  client: RoleGrantQueryClient,
    69	  userId: string,
    70	  orgId: string,
    71	): Promise<boolean> {
    72	  const { rows } = await client.query<{ ok: boolean }>(
    73	    `select true as ok
    74	       from public.user_roles ur
    75	       join public.roles r on r.id = ur.role_id and r.org_id = ur.org_id
    76	      where ur.user_id = $1::uuid
    77	        and ur.org_id = $2::uuid
    78	        and r.slug = any($3::text[])
    79	      limit 1`,
    80	    [userId, orgId, ALL_SITE_AUTHORITY_ROLE_SLUGS],
    81	  );
    82	  return rows[0]?.ok === true;
    83	}
    84	
    85	export async function readCallerPermissions(
    86	  client: RoleGrantQueryClient,
    87	  userId: string,
    88	  orgId: string,
    89	): Promise<Set<string>> {
    90	  const { rows } = await client.query<{ permission: string }>(
    91	    `select distinct perm as permission
    92	       from (
    93	         select rp.permission as perm
    94	           from public.user_roles ur
    95	           join public.roles r on r.id = ur.role_id and r.org_id = ur.org_id
    96	           join public.role_permissions rp on rp.role_id = r.id
    97	          where ur.user_id = $1::uuid
    98	            and ur.org_id = $2::uuid
    99	         union
   100	         select jsonb_array_elements_text(coalesce(r.permissions, '[]'::jsonb)) as perm
   101	           from public.user_roles ur
   102	           join public.roles r on r.id = ur.role_id and r.org_id = ur.org_id
   103	          where ur.user_id = $1::uuid
   104	            and ur.org_id = $2::uuid
   105	         union
   106	         -- Permission gates match r.code / r.slug via exact equality (e.g. r.code = $3).
   107	         -- Only dotted values are permission-shaped; bare role identifiers (operator) are not grants.
   108	         select r.code as perm
   109	           from public.user_roles ur
   110	           join public.roles r on r.id = ur.role_id and r.org_id = ur.org_id
   111	          where ur.user_id = $1::uuid
   112	            and ur.org_id = $2::uuid
   113	            and r.code is not null
   114	            and r.code like '%.%'
   115	         union
   116	         select r.slug as perm
   117	           from public.user_roles ur
   118	           join public.roles r on r.id = ur.role_id and r.org_id = ur.org_id
   119	          where ur.user_id = $1::uuid
