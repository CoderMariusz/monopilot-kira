   784	async function loadWhereUsed(ctx: OrgContextLike, definitionId: string): Promise<unknown[]> {
   785	  const { rows } = await ctx.client.query(
   786	    `select p.id as "projectId",
   787	            p.name as "projectName",
   788	            p.product_code as "fgCode",
   789	            ack.accepted_version as "acceptedVersion"
   790	       from public.formulation_ingredients fi
   791	       join public.formulation_versions fv on fv.id = fi.version_id
   792	       join public.formulations f on f.id = fv.formulation_id
   793	       join public.npd_projects p on p.id = f.project_id and p.org_id = f.org_id
   794	       left join public.wip_definition_acks ack
   795	         on ack.org_id = p.org_id
   796	        and ack.wip_definition_id = $1::uuid
   797	        and ack.npd_project_id = p.id
   798	      where f.org_id = app.current_org_id()
   799	        and fi.wip_definition_id = $1::uuid
   800	      group by p.id, p.name, p.product_code, ack.accepted_version
   801	      order by p.name asc`,
   802	    [definitionId],
   803	  );
   804	  return rows;
   805	}
   806	
   807	async function loadDefinitionContent(ctx: OrgContextLike, definitionId: string, definition: ExistingDefinition): Promise<unknown> {
   808	  const ingredients = await ctx.client.query(
   809	    `select item_id as "itemId", qty_per_unit as "qtyPerUnit", uom, sequence
   810	       from public.wip_definition_ingredients
   811	      where org_id = app.current_org_id()
   812	        and wip_definition_id = $1::uuid
   813	      order by sequence asc, item_id asc`,
   814	    [definitionId],
   815	  );
   816	  return canonicalContent({
   817	    name: definition.name,
   818	    description: definition.description,
   819	    baseUom: definition.base_uom,
   820	    yieldPct: definition.yield_pct,
   821	    reusable: definition.reusable,
   822	    ingredients: ingredients.rows,
   823	    processes: await loadDefinitionProcesses(ctx, definitionId),
   824	  });
   825	}
   826	
   827	function canonicalInputContent(input: {
   828	  name: string;
   829	  description?: string | null;
   830	  baseUom: string;
   831	  yieldPct: number;
   832	  reusable: boolean;
   833	  ingredients: unknown[];
   834	  processes: unknown[];
   835	}): unknown {
   836	  return canonicalContent(input);
   837	}
   838	
   839	function canonicalContent(input: Record<string, unknown>): unknown {
   840	  return {
   841	    name: String(input.name ?? '').trim(),
   842	    description: input.description ? String(input.description).trim() : null,
   843	    baseUom: input.baseUom,
   844	    yieldPct: Number(input.yieldPct).toFixed(3),
   845	    reusable: input.reusable === true,
   846	    ingredients: (input.ingredients as Array<Record<string, unknown>>).map((ingredient) => ({
   847	      itemId: ingredient.itemId,
   848	      qtyPerUnit: Number(ingredient.qtyPerUnit).toFixed(6),
   849	      uom: ingredient.uom,
   850	      sequence: Number(ingredient.sequence ?? 0),
   851	    })),
   852	    processes: (input.processes as Array<Record<string, unknown>>).map((process) => ({
   853	      processName: process.processName,
   854	      displayOrder: Number(process.displayOrder ?? 0),
   855	      durationHours: Number(process.durationHours ?? 0).toFixed(4),
   856	      additionalCost: Number(process.additionalCost ?? 0).toFixed(4),
   857	      throughputPerHour: process.throughputPerHour == null ? null : Number(process.throughputPerHour).toFixed(4),
   858	      throughputUom: process.throughputUom ?? null,
   859	      setupCost: Number(process.setupCost ?? 0).toFixed(4),
   860	      yieldPct: Number(process.yieldPct ?? 100).toFixed(3),
   861	      roles: (process.roles as Array<Record<string, unknown>> | undefined ?? []).map((role) => ({
   862	        roleGroup: role.roleGroup,
   863	        headcount: Number(role.headcount ?? 1),
   864	        ratePerHour: role.ratePerHour == null ? null : Number(role.ratePerHour).toFixed(4),
   865	      })),
   866	    })),
   867	  };
   868	}
   869	
   870	async function ensureDefinitionItem(ctx: OrgContextLike, name: string, baseUom: string): Promise<string> {
   871	  const itemCode = await mintWipItemCode(ctx, name);
   872	  const inserted = await ctx.client.query<{ id: string }>(
   873	    `insert into public.items
   874	       (org_id, item_code, item_type, name, origin_module, status, uom_base, created_by)
   875	     values
   876	       (app.current_org_id(), $1, 'intermediate', $2, 'npd', 'active', $3, $4::uuid)
   877	     returning id`,
   878	    [itemCode, name, baseUom, ctx.userId],
   879	  );
   880	  const itemId = inserted.rows[0]?.id;
   881	  if (!itemId) throw new Error('Could not create WIP definition item');
   882	  await writeAudit(ctx, 'wip_definition.item.create', 'item', itemId, null, { itemCode, name, baseUom });
   883	  return itemId;
   884	}
   885	
   886	async function mintWipItemCode(ctx: OrgContextLike, name: string): Promise<string> {
   887	  try {
   888	    return await nextEntityCode(ctx.client, ctx.orgId, 'wip');
   889	  } catch (error) {
   890	    if (error instanceof Error && (error.message === 'entity_code_settings_missing:wip' || error.message === 'entity_code_mask_missing:wip')) {
   891	      return `WIP-${name.trim().toUpperCase().replace(/[^A-Z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 32) || 'DEFINITION'}`;
   892	    }
   893	    throw error;
   894	  }
   895	}
   896	
   897	async function replaceDefinitionIngredients(
   898	  ctx: OrgContextLike,
   899	  definitionId: string,
   900	  ingredients: Array<{ itemId: string; qtyPerUnit: number; uom: string; sequence: number }>,
   901	): Promise<void> {
   902	  await ctx.client.query(
   903	    `delete from public.wip_definition_ingredients
   904	      where org_id = app.current_org_id()
   905	        and wip_definition_id = $1::uuid`,
   906	    [definitionId],
   907	  );
   908	  for (const ingredient of ingredients) {
   909	    await ctx.client.query(
   910	      `insert into public.wip_definition_ingredients
   911	         (org_id, wip_definition_id, item_id, qty_per_unit, uom, sequence)
   912	       values
   913	         (app.current_org_id(), $1::uuid, $2::uuid, $3::numeric, $4, $5::int)`,
   914	      [definitionId, ingredient.itemId, ingredient.qtyPerUnit, ingredient.uom, ingredient.sequence],
   915	    );
   916	  }
   917	}
