    19	export type StageGateEvaluation =
    20	  | { status: 'PASS' }
    21	  | { status: 'SOFT_GATE_BLOCKED'; missing: string[] }
    22	  | { status: 'HARD_BLOCKED'; hardReason: string; blockers?: GateBlocker[] };
    23	
    24	export type EvaluateStageGateOptions = {
    25	  /** Formal G3/G4 e-sign approval — enforces checklist/evidence without soft override. */
    26	  mode?: 'advance' | 'formal_approve';
    27	  approveGateCode?: 'G3' | 'G4';
    28	};
    29	
    30	type RequiredFieldRow = {
    31	  dept_code: string | null;
    32	  dept_name: string | null;
    33	  field_code: string | null;
    34	  field_label: string | null;
    35	  auto_source_field: string | null;
    36	  product_json: Record<string, unknown> | null;
    37	  project_json: Record<string, unknown> | null;
    38	};
    39	
    40	function resolveGateFieldValues(row: RequiredFieldRow): Record<string, unknown> {
    41	  if (row.product_json) return row.product_json;
    42	  const projectJson = row.project_json ?? {};
    43	  const rawFieldValues = projectJson.field_values;
    44	  const fieldValues =
    45	    typeof rawFieldValues === 'object' && rawFieldValues !== null && !Array.isArray(rawFieldValues)
    46	      ? (rawFieldValues as Record<string, unknown>)
    47	      : {};
    48	  const values: Record<string, unknown> = { ...fieldValues };
    49	  for (const [key, value] of Object.entries(projectJson)) {
    50	    if (key !== 'field_values') values[key] = value;
    51	  }
    52	  values.product_name = projectJson.name ?? null;
    53	  return values;
    54	}
    55	
    56	function isFilled(value: unknown): boolean {
    57	  if (value === null || value === undefined) return false;
    58	  if (typeof value === 'string') return value.trim() !== '';
    59	  if (Array.isArray(value)) return value.length > 0;
    60	  return true;
    61	}
    62	
    63	function missingToBlockers(missing: string[]): GateBlocker[] {
    64	  return missing.map((item) => ({
    65	    code: 'REQUIRED_EVIDENCE_MISSING',
    66	    message: item,
    67	    itemText: item,
    68	  }));
    69	}
    70	
    71	async function incompleteRequiredChecklistItems(
    72	  ctx: OrgContextLike,
    73	  projectId: string,
    74	  gateCode: ProjectGate,
    75	): Promise<string[]> {
    76	  if (gateCode === 'Launched') return [];
    77	  const [signals, checklist] = await Promise.all([
    78	    loadGateChecklistAutoSignals(ctx.client, projectId),
    79	    ctx.client.query<{ item_text: string; completed_at: string | null }>(
    80	      `select gci.item_text,
    81	              gci.completed_at::text as completed_at
    82	         from public.gate_checklist_items gci
    83	        where gci.org_id = app.current_org_id()
    84	          and gci.project_id = $1::uuid
    85	          and gci.gate_code = $2::text
    86	          and gci.required = true
    87	        order by gci.item_text asc`,
    88	      [projectId, gateCode],
    89	    ),
    90	  ]);
    91	  return checklist.rows
    92	    .filter((row) => !isGateChecklistItemResolved(row.item_text, row.completed_at, signals))
    93	    .map((row) => `Checklist: ${row.item_text.trim()}`);
    94	}
    95	
    96	async function requiredFieldsMissing(
    97	  ctx: OrgContextLike,
    98	  projectId: string,
    99	  stage: AnyStage,
   100	): Promise<string[]> {
   101	  if (stage === 'launched') return [];
   102	  const { rows } = await ctx.client.query<RequiredFieldRow>(
   103	    `select
   104	        d.code as dept_code,
   105	        d.name as dept_name,
   106	        f.code as field_code,
   107	        f.label as field_label,
   108	        f.auto_source_field,
   109	        case when p.product_code is not null then to_jsonb(p.*) end as product_json,
   110	        to_jsonb(np.*) as project_json
   111	       from public.npd_departments d
   112	       join public.npd_department_field df
   113	         on df.department_id = d.id
   114	        and df.org_id = d.org_id
   115	       join public.npd_field_catalog f
   116	         on f.id = df.field_id
   117	        and f.org_id = df.org_id
   118	       join public.npd_projects np
   119	         on np.id = $1::uuid
   120	        and np.org_id = app.current_org_id()
   121	       left join public.product p
   122	         on p.org_id = app.current_org_id()
   123	        and p.product_code = np.product_code
   124	      where d.org_id = app.current_org_id()
   125	        and d.active = true
   126	        and d.stage_code = $2::text
   127	        and df.visible = true
   128	        and df.required = true
   129	        and f.active = true
   130	      order by d.display_order asc, d.code asc, df.display_order asc, f.code asc`,
   131	    [projectId, stage],
   132	  );
   133	
   134	  const missing: string[] = [];
   135	  for (const row of rows) {
   136	    const fieldCode = (row.field_code ?? '').trim().toLowerCase();
   137	    if (!fieldCode) continue;
   138	    const autoSource = (row.auto_source_field ?? '').trim().toLowerCase();
   139	    const values = resolveGateFieldValues(row);
   140	    const value = autoSource && autoSource in values ? values[autoSource] : values[fieldCode];
   141	    if (!isFilled(value)) {
   142	      const dept = (row.dept_name ?? row.dept_code ?? 'Stage field').trim();
   143	      const field = (row.field_label ?? fieldCode).trim();
   144	      missing.push(`${dept}: ${field}`);
   145	    }
   146	  }
   147	  return missing;
   148	}
   149	
   150	export async function writeGateOverrideAudit(
   151	  ctx: OrgContextLike,
   152	  params: {
   153	    projectId: string;
   154	    fromStage: AnyStage;
   155	    toStage: AnyStage;
   156	    missing: string[];
   157	    note: string;
   158	  },
   159	): Promise<void> {
   160	  const payload = {
   161	    fromStage: params.fromStage,
   162	    toStage: params.toStage,
   163	    missing: params.missing,
   164	    note: params.note,
   165	    actor: ctx.userId,
   166	  };
   167	  await ctx.client.query(
   168	    `insert into public.audit_log
   169	       (org_id, actor_user_id, actor_type, action, resource_type, resource_id,
   170	        before_state, after_state, request_id, retention_class)
   171	     values (app.current_org_id(), $1::uuid, 'user', 'npd.stage.gate_overridden',
   172	             'npd_project', $2, null, $3::jsonb, $4::uuid, 'operational')`,
   173	    [ctx.userId, params.projectId, JSON.stringify(payload), randomUUID()],
   174	  );
   175	}
   176	
   177	export async function evaluateStageGate(
   178	  projectId: string,
   179	  fromStage: AnyStage,
   180	  toStage: AnyStage,
   181	  db: OrgContextLike,
   182	  project?: GateProjectRow,
   183	  options?: EvaluateStageGateOptions,
   184	): Promise<StageGateEvaluation> {
   185	  const mode = options?.mode ?? 'advance';
   186	  const projectRow = project ?? await loadProjectForUpdate(db, projectId);
   187	  const readiness = resolveGateReadiness(projectRow);
   188	  const checklistGate = mode === 'formal_approve' && options?.approveGateCode
   189	    ? options.approveGateCode
   190	    : readiness.checklistGate;
   191	
   192	  const blockers = await getBlockers(db, projectRow, toStage);
   193	  if (blockers.length > 0) {
   194	    return { status: 'HARD_BLOCKED', hardReason: blockers[0]?.code ?? 'BLOCKERS_PRESENT', blockers };
   195	  }
   196	
   197	  if (mode === 'advance') {
   198	    if (readiness.currentGate === 'G3' && resolveAdvanceTransition(projectRow)?.targetGate === 'G4') {
   199	      await assertG3ESignForApproval(db, projectId);
   200	    }
   201	    if (fromStage === 'approval' && toStage === 'handoff') {
   202	      await assertG4ESignForHandoff(db, projectId);
   203	    }
   204	  }
   205	
   206	  const requiredEvidenceMissing: string[] = [
   207	    ...(await incompleteRequiredChecklistItems(db, projectId, checklistGate)),
   208	    ...(await requiredFieldsMissing(db, projectId, fromStage)),
   209	  ];
   210	  if (requiredEvidenceMissing.length > 0) {
   211	    return {
   212	      status: 'HARD_BLOCKED',
   213	      hardReason: 'REQUIRED_EVIDENCE_BLOCKED',
   214	      blockers: missingToBlockers(requiredEvidenceMissing),
   215	    };
   216	  }
   217	
   218	  if (mode === 'advance' && fromStage === 'costing_nutrition' && toStage === 'trial') {
   219	    const advisoryMissing: string[] = [];
   220	    const readinessCheck = await checkCostingNutritionReady(db, projectId);
   221	    if (!readinessCheck.costReady) advisoryMissing.push('Cost breakdown computed');
   222	    if (!readinessCheck.nutritionReady) advisoryMissing.push('Nutrition computed');
   223	    if (advisoryMissing.length > 0) {
   224	      return { status: 'SOFT_GATE_BLOCKED', missing: advisoryMissing };
   225	    }
   226	  }
   227	
   228	  return { status: 'PASS' };
   229	}
     1	'use server';
     2	
     3	import { signEvent } from '@monopilot/e-sign';
     4	import type { ESignTxOptions } from '@monopilot/e-sign';
     5	import { z } from 'zod';
     6	
     7	import { withOrgContext } from '../../../../lib/auth/with-org-context';
     8	import {
     9	  APP_VERSION,
    10	  GATE_APPROVE_PERMISSION,
    11	  GATE_APPROVED_EVENT,
    12	  deterministicApprovalHash,
    13	  assertAdjacentStage,
    14	  assertGateStageConsistent,
    15	  emitOutbox,
    16	  gateForStage,
    17	  loadProjectForUpdate,
    18	  requireActionPermission,
    19	  seedHandoffChecklist,
    20	  serializeGateError,
    21	  updateProjectStage,
    22	  type AnyStage,
    23	  type GateBlocker,
    24	} from './_lib/gate-helpers';
    25	import { evaluateStageGate } from './_lib/evaluate-stage-gate';
    26	import { type OrgContextLike, type ProjectGate } from './shared';
    27	import { revalidateLocalized } from '../../../../lib/i18n/revalidate-localized';
    28	
    29	// T-111 reconciliation: the e-signature password is required ONLY when approving
    30	// (G3/G4 require a BRCGS/CFR-21 e-sign). A rejection records the reason WITHOUT a
    31	// password and WITHOUT an e-signature (signEvent is never invoked on the reject path).
    32	// A discriminated union enforces this at the schema boundary: a stray `password` on
    33	// the reject branch is stripped, and a missing `password` on the approve branch is a
    34	// 400 INVALID_INPUT before any DB / e-sign work.
    35	const approveSchema = z.object({
    36	  projectId: z.string().uuid(),
    37	  gateCode: z.enum(['G3', 'G4']),
    38	  decision: z.literal('approved'),
    39	  notes: z.string().trim().min(1).max(2000),
    40	  password: z.string().min(1).max(256),
    41	});
    42	
    43	const rejectSchema = z.object({
    44	  projectId: z.string().uuid(),
    45	  gateCode: z.enum(['G3', 'G4']),
    46	  decision: z.literal('rejected'),
    47	  notes: z.string().trim().min(1).max(2000),
    48	});
    49	
    50	const inputSchema = z.discriminatedUnion('decision', [approveSchema, rejectSchema]);
    51	
    52	export type ApproveProjectGateResult =
    53	  | {
    54	      ok: true;
    55	      data: {
    56	        projectId: string;
    57	        approvedGate: 'G3' | 'G4';
    58	        decision: 'approved' | 'rejected';
    59	        currentGate: ProjectGate;
    60	        currentStage: AnyStage;
    61	        approvalId: string;
    62	        outboxEventType: typeof GATE_APPROVED_EVENT;
    63	      };
    64	    }
    65	  | { ok: false; error: string; status: number; blockers?: GateBlocker[] };
    66	
    67	export async function approveProjectGate(rawInput: unknown): Promise<ApproveProjectGateResult> {
    68	  const parsed = inputSchema.safeParse(rawInput);
    69	  if (!parsed.success) return { ok: false, error: 'INVALID_INPUT', status: 400 };
    70	
    71	  try {
    72	    return await withOrgContext<ApproveProjectGateResult>(async (ctx) => {
    73	      const context = ctx as OrgContextLike;
    74	      await requireActionPermission(context, GATE_APPROVE_PERMISSION);
    75	
    76	      const project = await loadProjectForUpdate(context, parsed.data.projectId);
    77	      assertGateStageConsistent(project);
    78	      // The project's DERIVED gate (from current_stage) must match the gate being
    79	      // approved. G3 → packaging/trial/sensory/pilot; G4 → approval/handoff.
    80	      if (project.current_gate !== parsed.data.gateCode) {
    81	        return { ok: false, error: 'GATE_MISMATCH', status: 409 };
    82	      }
    83	
    84	      // G3/G4 e-sign approval records the checkpoint signature. Stage advancement only
    85	      // happens when the target stage is adjacent to the current stage (pilot→approval
    86	      // for G3, approval→handoff for G4) — never by skipping intermediate G3 substages.
    87	      const targetStage =
    88	        parsed.data.decision === 'approved'
    89	          ? approvalTargetStage(project.current_stage, parsed.data.gateCode)
    90	          : null;
    91	      if (parsed.data.decision === 'approved') {
    92	        const gateEvaluation = await evaluateStageGate(
    93	          project.id,
    94	          project.current_stage as AnyStage,
    95	          targetStage ?? (project.current_stage as AnyStage),
    96	          context,
    97	          project,
    98	          { mode: 'formal_approve', approveGateCode: parsed.data.gateCode },
    99	        );
   100	        if (gateEvaluation.status === 'HARD_BLOCKED') {
   101	          return {
   102	            ok: false,
   103	            error: 'BLOCKERS_PRESENT',
   104	            status: 409,
   105	            blockers: gateEvaluation.blockers,
   106	          };
   107	        }
   108	        if (gateEvaluation.status === 'SOFT_GATE_BLOCKED') {
   109	          return {
   110	            ok: false,
   111	            error: 'BLOCKERS_PRESENT',
   112	            status: 409,
   113	            blockers: gateEvaluation.missing.map((item) => ({
   114	              code: 'REQUIRED_EVIDENCE_MISSING' as const,
   115	              message: item,
   116	              itemText: item,
   117	            })),
   118	          };
   119	        }
   120	      }
   121	
   122	      let currentGate: ReturnType<typeof gateForStage> = project.current_gate;
   123	
   124	      // E-signature is collected ONLY on the approve path (G3/G4 require it). A rejection
   125	      // records the reason with no password and no signature (esigned_at/esign_hash null).
   126	      let esignedAt: string | null = null;
   127	      let esignHash: string | null = null;
   128	      let signatureId: string | null = null;
   129	      if (parsed.data.decision === 'approved') {
   130	        const receipt = await signEvent(
   131	          {
   132	            signerUserId: context.userId,
   133	            pin: parsed.data.password,
   134	            intent: `npd.gate.${parsed.data.decision}`,
   135	            subject: {
   136	              projectId: project.id,
   137	              projectCode: project.code,
   138	              gateCode: parsed.data.gateCode,
   139	              decision: parsed.data.decision,
   140	            },
   141	            nonce: `${project.id}:${parsed.data.gateCode}:${parsed.data.decision}:${Date.now()}`,
   142	            reason: parsed.data.notes,
   143	          },
   144	          { client: context.client as ESignTxOptions['client'] },
   145	        );
   146	        esignedAt = new Date(receipt.signedAt).toISOString();
   147	        esignHash = deterministicApprovalHash(context.userId, project.id, parsed.data.gateCode, esignedAt);
   148	        signatureId = receipt.signatureId;
   149	      }
   150	
   151	      const approval = await context.client.query<{ id: string }>(
   152	        `insert into public.gate_approvals
   153	           (org_id, project_id, gate_code, decision, approver_user_id, notes, rejection_reason, esigned_at, esign_hash)
   154	         values
   155	           (app.current_org_id(), $1::uuid, $2, $3, $4::uuid, $5, $6, $7::timestamptz, $8)
   156	         returning id`,
   157	        [
   158	          project.id,
   159	          parsed.data.gateCode,
   160	          parsed.data.decision,
   161	          context.userId,
   162	          parsed.data.notes,
   163	          parsed.data.decision === 'rejected' ? parsed.data.notes : null,
   164	          esignedAt,
   165	          esignHash,
   166	        ],
   167	      );
   168	      const approvalId = approval.rows[0]?.id;
   169	      if (!approvalId) return { ok: false, error: 'PERSISTENCE_FAILED', status: 500 };
   170	
   171	      let currentStage = project.current_stage as AnyStage;
   172	      if (parsed.data.decision === 'approved' && targetStage) {
   173	        assertAdjacentStage(project.current_stage, targetStage);
   174	        if (project.current_stage === 'approval' && targetStage === 'handoff') {
   175	          await seedHandoffChecklist(context, project);
   176	        }
   177	        await updateProjectStage(context, project.id, targetStage);
   178	        currentStage = targetStage;
   179	        currentGate = gateForStage(targetStage);
   180	      }
   181	
   182	      await emitOutbox(context, {
   183	        eventType: GATE_APPROVED_EVENT,
   184	        aggregateType: 'npd_project',
   185	        aggregateId: project.id,
   186	        payload: {
   187	          org_id: context.orgId,
   188	          actor_user_id: context.userId,
   189	          project_id: project.id,
   190	          project_code: project.code,
   191	          gate_code: parsed.data.gateCode,
   192	          decision: parsed.data.decision,
   193	          current_gate: currentGate,
   194	          current_stage: currentStage,
   195	          approval_id: approvalId,
   196	          e_sign_signature_id: signatureId,
   197	          esign_hash: esignHash,
   198	        },
   199	        dedupKey: `${GATE_APPROVED_EVENT}:${approvalId}`,
   200	      });
   201	
   202	      safeRevalidatePath(`/npd/pipeline/${project.id}`);
   203	      return {
   204	        ok: true,
   205	        data: {
   206	          projectId: project.id,
   207	          approvedGate: parsed.data.gateCode,
   208	          decision: parsed.data.decision,
   209	          currentGate,
   210	          currentStage,
   211	          approvalId,
   212	          outboxEventType: GATE_APPROVED_EVENT,
   213	        },
   214	      };
   215	    });
   216	  } catch (error) {
   217	    const serialized = serializeGateError(error);
   218	    if (serialized) return serialized;
   219	    if (error instanceof Error && /pin|failed|locked/i.test(error.message)) {
   220	      return { ok: false, error: 'ESIGN_FAILED', status: 403 };
   221	    }
   222	    console.error('[approveProjectGate] persistence_failed', {
   223	      appVersion: APP_VERSION,
   224	      error: error instanceof Error ? error.message : String(error),
   225	    });
   226	    return { ok: false, error: 'PERSISTENCE_FAILED', status: 500 };
   227	  }
   228	}
   229	
   230	function approvalTargetStage(currentStage: string, gateCode: 'G3' | 'G4'): AnyStage | null {
   231	  if (gateCode === 'G3' && currentStage === 'pilot') return 'approval';
   232	  if (gateCode === 'G4' && currentStage === 'approval') return 'handoff';
   233	  return null;
   234	}
   235	
   236	function safeRevalidatePath(path: string): void {
   237	  try {
   238	    revalidateLocalized(path);
   239	  } catch {
   240	    // Vitest imports Server Actions outside a Next request/static generation store.
   241	  }
   242	}
     1	'use server';
     2	
     3	import { z } from 'zod';
     4	
     5	import { withOrgContext } from '../../../../lib/auth/with-org-context';
     6	import {
     7	  APP_VERSION,
     8	  FG_CANDIDATE_STAGE,
     9	  GATE_ADVANCE_PERMISSION,
    10	  GATE_APPROVE_PERMISSION,
    11	  GATE_ADVANCED_EVENT,
    12	  STAGE_ORDER,
    13	  assertHonestGateAdvance,
    14	  createFgCandidate,
    15	  emitOutbox,
    16	  loadProjectForUpdate,
    17	  requireActionPermission,
    18	  resolveAdvanceTransition,
    19	  seedHandoffChecklist,
    20	  serializeGateError,
    21	  updateProjectGateOnly,
    22	  updateProjectStage,
    23	  type AnyStage,
    24	  type GateBlocker,
    25	} from './_lib/gate-helpers';
    26	import { evaluateStageGate, writeGateOverrideAudit } from './_lib/evaluate-stage-gate';
    27	import { closeOutLegacyStagesForLaunch } from './close-out-legacy-stages';
    28	import { type OrgContextLike, type ProjectGate } from './shared';
    29	import { revalidateLocalized } from '../../../../lib/i18n/revalidate-localized';
    30	
    31	// ─────────────────────────────────────────────────────────────────────────────
    32	// advanceProjectGate — STAGE-NATIVE advance (2026-06-06 pivot).
    33	//
    34	// The project advances ONE operational stage at a time through STAGE_ORDER. The
    35	// caller passes the `targetStage` (the next stage); we assert it is exactly the
    36	// successor of current_stage (no skipping), run the current-stage blockers, perform
    37	// the per-transition side effects, then persist the new stage + DERIVED gate.
    38	//
    39	// Side effects keyed by the stage being ENTERED:
    40	//   • entering `packaging` (3rd stage = entering G3) → createFgCandidate (idempotent;
    41	//     the product is a CANDIDATE, never active — activation is the handoff promotion).
    42	//   • approval → handoff                            → require a valid G4 e-signature
    43	//     (assertG4ESignForHandoff; collected by approveProjectGate).
    44	//   • handoff  → launched                           → closeOutLegacyStagesForLaunch
    45	//     (the existing terminal closeout; full FG activation is promoteToProduction).
    46	//
    47	// INPUT: `targetStage` only — the next stage in STAGE_ORDER (or 'launched' after
    48	// handoff). The old `targetGate` shape is gone; callers that reason in gate space
    49	// (bulk-move) translate a gate into the corresponding single stage step.
    50	// ─────────────────────────────────────────────────────────────────────────────
    51	
    52	const STAGE_VALUES = [...STAGE_ORDER, 'launched'] as const;
    53	
    54	const inputSchema = z.object({
    55	  projectId: z.string().uuid(),
    56	  targetStage: z.enum(STAGE_VALUES),
    57	  productCode: z.string().trim().min(1).max(80).optional().nullable(),
    58	  /** Optional audit note from the advance modal; stored in the outbox event payload. */
    59	  notes: z.string().trim().max(2000).optional().nullable(),
    60	  override: z.object({
    61	    note: z.string().trim().min(1).max(2000),
    62	  }).optional(),
    63	});
    64	
    65	export type AdvanceProjectGateResult =
    66	  | {
    67	      ok: true;
    68	      data: {
    69	        projectId: string;
    70	        previousGate: ProjectGate;
    71	        currentGate: ProjectGate;
    72	        previousStage: string;
    73	        currentStage: AnyStage;
    74	        productCode: string | null;
    75	        outboxEventType: typeof GATE_ADVANCED_EVENT;
    76	      };
    77	    }
    78	  | { ok: false; error: string; status: number; blockers?: GateBlocker[]; missing?: string[] };
    79	
    80	export { evaluateStageGate } from './_lib/evaluate-stage-gate';
    81	
    82	export async function advanceProjectGate(rawInput: unknown): Promise<AdvanceProjectGateResult> {
    83	  const parsed = inputSchema.safeParse(rawInput);
    84	  if (!parsed.success) return { ok: false, error: 'INVALID_INPUT', status: 400 };
    85	
    86	  try {
