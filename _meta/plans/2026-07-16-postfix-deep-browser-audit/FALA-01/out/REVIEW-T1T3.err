   165	  await owner.query(`delete from public.npd_projects where org_id in ($1, $2)`, [seed.orgAId, seed.orgBId]);
   166	  await owner.query(`delete from public.product where org_id in ($1, $2)`, [seed.orgAId, seed.orgBId]);
   167	  await owner.query(`delete from public.user_pins where user_id in ($1, $2, $3)`, [
   168	    seed.userAId,
   169	    seed.userBId,
   170	    viewerUserId,
   171	  ]);
   172	  await owner.query(`delete from public.user_roles where org_id in ($1, $2)`, [seed.orgAId, seed.orgBId]);
