    15	  add column if not exists scim_token_hash      text,
    16	  add column if not exists scim_token_last_four text;
    17	
    18	-- JIT provisioning column
    19	alter table public.tenant_idp_config
    20	  add column if not exists jit_provisioning boolean not null default false;
    21	
    22	-- Enforcement column
    23	alter table public.tenant_idp_config
    24	  add column if not exists enforce_for_non_admins boolean not null default false;
    25	
    26	-- Password lifecycle columns
