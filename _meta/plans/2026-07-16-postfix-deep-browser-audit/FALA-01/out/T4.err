+    `select exists (
+       select 1
+         from public.e_sign_log
+        where org_id = app.current_org_id()
+          and intent = $1
+          and nonce = $2
+     ) as exists`,
+    [BUNDLE_APPROVE_INTENT, `${spec.id}:${spec.bom_header_id}:approve`],
+  );
+  return rows[0]?.exists === true;
+}
